if (is_osx) view.windowBlurbehind = #light;
stdout.println("current platform:", OS);
stdout.println("is_xfce: ", is_xfce);

// See default height in common.tis `msgbox()`.
const msgbox_default_height = 180;
const incoming_only_width = 180;

const outgoing_only = handler.is_outgoing_only();
const incoming_only = handler.is_incoming_only();
const disable_installation = handler.is_disable_installation();
const disable_account = handler.is_disable_account();
const disable_settings = handler.is_disable_settings();
const is_custom_client = handler.is_custom_client();
const disable_ab = handler.is_disable_ab();
const hide_server_settings = handler.get_builtin_option("hide-server-settings") == "Y";
const hide_proxy_settings = handler.get_builtin_option("hide-proxy-settings") == "Y";
const hide_websocket_settings = handler.get_builtin_option("hide-websocket-settings") == "Y";
const hide_stop_service = handler.get_builtin_option("hide-stop-service") == "Y";
const disable_change_permanent_password = handler.get_builtin_option("disable-change-permanent-password") == "Y";
const disable_change_id = handler.get_builtin_option("disable-change-id") == "Y";

// Nemo feature: keep the initial Windows Sciter client window large enough
// for startup cards/status text. Runtime layout is untouched; set this to
// false to return to vanilla startup sizing without removing the code.
const nemo_fit_initial_window_to_content = true;
const nemo_initial_window_fit_padding = 24;

// Nemo feature: normal launches keep editable/persistent GUI server settings,
// while custom-name executables such as rustdesk-host=...,key=... lock them.
const nemo_gui_server_settings = true;
const nemo_company_network_only_option = "nemo-company-network-only";
const nemo_management_settings = true;
const nemo_management_enabled_option = "nemo-management-enabled";
const nemo_management_server_option = "nemo-management-server";
const nemo_management_public_key_option = "nemo-management-public-key";
const nemo_outbound_enabled_option = "nemo-outbound-enabled";
const nemo_outbound_targets_option = "nemo-outbound-targets";

// html min-width, min-height not working on mac, below works for all
if (incoming_only) {
  view.windowMinSize = (scaleIt(incoming_only_width), scaleIt((handler.is_installed() || disable_installation) ? 300 : 390));
} else {
  view.windowMinSize = (scaleIt(560), scaleIt(300));
}

var app;
var tmp = handler.get_connect_status();
var connect_status = tmp[0];
var service_stopped = handler.get_option("stop-service") == "Y";
var disable_udp = handler.get_option("disable-udp") == "Y";
var using_public_server = handler.using_public_server();
var software_update_url = "";
var key_confirmed = tmp[1];
var system_error = "";

const default_option_lang = is_custom_client ? 'default' : '';
const default_option_yes = is_custom_client ? 'Y' : '';
const default_option_no = is_custom_client ? 'N' : '';
const default_option_whitelist = is_custom_client ? ',' : '';
const default_option_approve_mode = is_custom_client ? 'password-click' : '';

const grey_text_style = "color:#888;";

var svg_menu = <svg #menu viewBox="0 0 512 512">
	<circle cx="256" cy="256" r="64"/>
	<circle cx="256" cy="448" r="64"/>
	<circle cx="256" cy="64" r="64"/>
</svg>;
var svg_refresh_password = <svg #refresh-password xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38"/></svg>;

var my_id = handler.get_id();
function get_id() {
  my_id = handler.get_id();
  return my_id;
}

function get_msgbox_width(width=500) {
    if (incoming_only) {
        var maxw = scaleIt(incoming_only_width);
        if (width > maxw) width = maxw;
    }
    return width;
}

class ConnectStatus: Reactor.Component {
    function render() {
        return
            <div .connect-status>
                <span class={"connect-status-icon connect-status" + (service_stopped ? 0 : connect_status)} />
                {this.getConnectStatusStr()}
                {service_stopped ? <span .link #start-service>{translate('Start service')}</span> : ""}
            </div>;
    }

    function getConnectStatusStr() {
        if (service_stopped) {
            return translate("Service is not running");
        } else if (connect_status == -1) {
            return translate('not_ready_status');
        } else if (connect_status == 0) {
            return translate('connecting_status');
        }
        if (!handler.using_public_server()) return translate('Ready');
        return <span>{translate("Ready")}, <span .link #setup-server>{translate("setup_server_tip")}</span></span>;
    }

    event click $(#start-service) () {
        handler.set_option("stop-service", "");
    }

    event click $(#setup-server) () {
        handler.open_url("https://rustdesk.com/blog/id-relay-set/");
    }
}

function nemoExeServerSettingsLocked() {
    return nemo_gui_server_settings && handler.get_license() != "";
}

function nemoManagementServerSettingsLocked() {
    return handler.is_option_fixed("custom-rendezvous-server")
        || handler.is_option_fixed("relay-server")
        || handler.is_option_fixed("api-server")
        || handler.is_option_fixed("key")
        || handler.is_option_fixed(nemo_company_network_only_option);
}

function nemoCompanyNetworkOnly() {
    return handler.get_option(nemo_company_network_only_option) == "Y";
}

function nemoPublicNetworkBlocked() {
    return nemoExeServerSettingsLocked() || nemoCompanyNetworkOnly();
}

function nemoRemoteIdUsesPublicServer(id) {
    var at = id.indexOf("@");
    if (at < 0) return false;
    var server = id.substr(at + 1).split("?")[0].trim().toLowerCase();
    return server == "public";
}

function nemoCurrentServerIsPublic() {
    if (nemoExeServerSettingsLocked()) return false;
    var options = handler.get_options();
    return (options["custom-rendezvous-server"] || "").trim() == "";
}

function nemoOutboundEnabled() {
    return handler.get_option(nemo_outbound_enabled_option) != "N";
}

function nemoOutboundTargetAllowed(id) {
    var targets = (handler.get_option(nemo_outbound_targets_option) || "").trim();
    if (!targets) return true;
    var parts = targets.split(/[,\s;]+/);
    for (var target in parts) {
        target = (target || "").trim();
        if (target == "*" || target == id) return true;
    }
    return false;
}

function createNewConnect(id, type) {
    id = id.replace(/\s/g, "");
    app.remote_id.value = formatId(id);
    if (!id) return;
    if (!nemoOutboundEnabled()) {
        msgbox("custom-error", "Error", "Outgoing connections are disabled by TBF policy");
        return;
    }
    if (nemo_gui_server_settings && nemoRemoteIdUsesPublicServer(id) && nemoPublicNetworkBlocked()) {
        msgbox("custom-error", "Error", "Public network access is disabled by TBF company network mode");
        return;
    }
    if (nemo_gui_server_settings && nemoCompanyNetworkOnly() && nemoCurrentServerIsPublic()) {
        msgbox("custom-error", "Error", "Company network only requires an ID server");
        return;
    }
    var old_id = id;
    id = handler.handle_relay_id(id);
    var force_relay = old_id != id; 
    if (id == my_id) {
        msgbox("custom-error", "Error", "You cannot connect to your own computer");
        return;
    }
    if (!nemoOutboundTargetAllowed(id)) {
        msgbox("custom-error", "Error", "Target is not allowed by TBF policy");
        return;
    }
    handler.set_remote_id(id);
    handler.new_remote(id, type, force_relay);
}

class ShareRdp: Reactor.Component {
    function render() {
        var rdp_shared_string = translate("Enable RDP session sharing");
        var cls = handler.is_share_rdp()  ? "selected" : "line-through";
        return <li class={cls}><span>{svg_checkmark}</span>{rdp_shared_string}</li>;
    }
    
    function onClick() {
        handler.set_share_rdp(!handler.is_share_rdp());
        this.update();
    }
}

var direct_server;
class DirectServer: Reactor.Component {
    function this() {
        direct_server = this;
    }

    function render() {
        var text = translate("Enable direct IP access");
        var enabled = handler.get_option("direct-server") == "Y";
        var cls = enabled ? "selected" : "line-through";
        return <li class={cls}><span>{svg_checkmark}</span>{text}{enabled && <EditDirectAccessPort />}</li>;
    }
    
    function onClick() {
        if (is_edit_rdp_port) {
            is_edit_rdp_port = false;
            return;
        }
        handler.set_option("direct-server", handler.get_option("direct-server") == "Y" ? default_option_no : "Y");
        this.update();
    }
}

var myIdMenu;
var audioInputMenu;
class AudioInputs: Reactor.Component {
    function this() {
        audioInputMenu = this;
    }

    function render() {
        if (!this.show) return <li />;
        var inputs = handler.get_sound_inputs();
        if (is_win) inputs = ["System Sound"].concat(inputs);
        if (!inputs.length) return <li style="display:hidden" />;
        var me = this;
        self.timer(1ms, function() { me.toggleMenuState() });
        return <li>{translate('Audio Input')}
            <menu #audio-input key={inputs.length}>
                <li #enable-audio><span>{svg_checkmark}</span>{translate("Mute")}</li>
                <div .separator />
                {inputs.map(function(name) {
                return <li id={name}><span>{svg_checkmark}</span>{translate(name)}</li>;
                })}
            </menu>
        </li>;
    }

    function get_default() {
        if (is_win) return "System Sound";
        return "";
    }

    function get_value() {
        return handler.get_option("audio-input") || this.get_default();
    }

    function toggleMenuState() {
        var el = this.$(li#enable-audio);
        var enabled = handler.get_option(el.id) != "N";
        el.attributes.toggleClass("selected", !enabled);
        var is_opt_fixed = handler.is_option_fixed("enable-audio");
        if (disable_settings || is_opt_fixed) {
            el.state.disabled = true;
        }
        var v = this.get_value();
        for (var el in this.$$(menu#audio-input>li)) {
            if (el.id == 'enable-audio') continue;
            var selected = el.id == v;
            el.attributes.toggleClass("selected", selected);
        }
    }

    event click $(menu#audio-input>li) (_, me) {
        if (me.state.disabled) return;
        var v = me.id;
        if (v == 'enable-audio') {
            handler.set_option(v, handler.get_option(v) != 'N' ? 'N' : default_option_yes);
        } else {
          if (v == this.get_value()) return;
          if (v == this.get_default()) v = "";
          handler.set_option("audio-input", v);
        }
        this.toggleMenuState();
    }
};

class Languages: Reactor.Component {
    function render() {
        var langs = JSON.parse(handler.get_langs());
        var me = this;
        self.timer(1ms, function() { me.toggleMenuState() });
        return <li>{translate('Language')}
            <menu #languages key={langs.length}>
                <li id="default"><span>{svg_checkmark}</span>Default</li>
                <div .separator />
                {langs.map(function(lang) {
                return <li id={lang[0]}><span>{svg_checkmark}</span>{lang[1]}</li>;
                })}
            </menu>
        </li>;
    }


    function toggleMenuState() {
        var cur = handler.get_local_option("lang") || "default";
        var is_opt_fixed = handler.is_option_fixed("lang");
        for (var el in this.$$(menu#languages>li)) {
            var selected = cur == el.id;
            el.attributes.toggleClass("selected", selected);
            if (is_opt_fixed) {
                el.state.disabled = true;
            }
        }
    }

    event click $(menu#languages>li) (_, me) {
        if (me.state.disabled) return;
        var v = me.id;
        if (v == "default") v = default_option_lang;
        handler.set_local_option("lang", v);
        app.update();
        this.toggleMenuState();
    }
}

var enhancementsMenu;
class Enhancements: Reactor.Component {
    function this() {
        enhancementsMenu = this;
    }

    function render() {
        var has_hwcodec = handler.has_hwcodec();
        var has_vram = handler.has_vram();
        var support_remove_wallpaper = handler.support_remove_wallpaper();
        var me = this;
        self.timer(1ms, function() { me.toggleMenuState() });
        return <li>{translate('Enhancements')}
            <menu #enhancements-menu>
                {(has_hwcodec || has_vram) ? <li #enable-hwcodec><span>{svg_checkmark}</span>{translate("Enable hardware codec")}</li> : ""}
                <li #enable-abr><span>{svg_checkmark}</span>{translate("Adaptive bitrate")} (beta)</li>
                <li #screen-recording>{translate("Recording")}</li>
                {support_remove_wallpaper ? <li #allow-remove-wallpaper><span>{svg_checkmark}</span>{translate("Remove wallpaper during incoming sessions")}</li> : ""}
                <li #keep-awake-during-incoming-sessions><span>{svg_checkmark}</span>{translate("keep-awake-during-incoming-sessions-label")}</li>
            </menu>
        </li>;
    }

    function toggleMenuState() {
        for (var el in $$(menu#enhancements-menu>li)) {
            if (el.id && el.id.indexOf("enable-") == 0) {
                var enabled = handler.get_option(el.id) != "N";
                el.attributes.toggleClass("selected", enabled);
                var is_opt_fixed = handler.is_option_fixed(el.id);
                if (is_opt_fixed) {
                    el.state.disabled = true;
                }
            } else if (el.id && el.id.indexOf("allow-") == 0) {
                var enabled = handler.get_option(el.id) == "Y";
                el.attributes.toggleClass("selected", enabled);
                var is_opt_fixed = handler.is_option_fixed(el.id);
                if (is_opt_fixed) {
                    el.state.disabled = true;
                }
            } else if (el.id == "keep-awake-during-incoming-sessions") {
                var enabled = handler.get_option(el.id) != "N";
                el.attributes.toggleClass("selected", enabled);
                var is_opt_fixed = handler.is_option_fixed(el.id);
                if (is_opt_fixed) {
                    el.state.disabled = true;
                }
            }
        }

    }

    event click $(menu#enhancements-menu>li) (_, me) {
        if (me.state.disabled) return;
        var v = me.id;
        if (v.indexOf("enable-") == 0) {
            var set_value = handler.get_option(v) != 'N' ? 'N' : default_option_yes;
            handler.set_option(v, set_value);
            if (v == "enable-hwcodec" && set_value != 'N') {
                handler.check_hwcodec();
            }
        } else if (v.indexOf("allow-") == 0) {
            handler.set_option(v, handler.get_option(v) == 'Y' ? default_option_no : 'Y');
        } else if (v == 'keep-awake-during-incoming-sessions') {
            handler.set_option(v, handler.get_option(v) != 'N' ? 'N' : default_option_yes);
        } else if (v == 'screen-recording') {
            var show_root_dir = is_win && handler.is_installed();
            var user_dir = handler.video_save_directory(false);
            var root_dir = show_root_dir ? handler.video_save_directory(true) : "";
            var ts0 = handler.get_option("enable-record-session") != 'N' ? { checked: true } : {};
            var ts1 = handler.get_option("allow-auto-record-incoming") == 'Y' ? { checked: true } : {};
            var ts2 = handler.get_local_option("allow-auto-record-outgoing") == 'Y' ? { checked: true } : {};
            var is_opt_fixed_enable_record = handler.is_option_fixed("enable-record-session");
            var is_opt_fixed_auto_incoming = handler.is_option_fixed("allow-auto-record-incoming");
            var is_opt_fixed_auto_outgoing = handler.is_option_fixed("allow-auto-record-outgoing");
            var is_opt_fixed_video_dir = handler.is_option_fixed("video-save-directory");
            if (is_opt_fixed_enable_record) { ts0.disabled = true; ts0.style = grey_text_style; }
            if (is_opt_fixed_auto_incoming) { ts1.disabled = true; ts1.style = grey_text_style; }
            if (is_opt_fixed_auto_outgoing) { ts2.disabled = true; ts2.style = grey_text_style; }
            msgbox("custom-recording", translate('Recording'),
                <div .form>
                    <div><button|checkbox(enable_record_session) {ts0} .wrap-text>{translate('Enable recording session')}</button></div>
                    <div><button|checkbox(auto_record_incoming) {ts1} .wrap-text>{translate('Automatically record incoming sessions')}</button></div>
                    <div><button|checkbox(auto_record_outgoing) {ts2} .wrap-text>{translate('Automatically record outgoing sessions')}</button></div>
                    <div class={is_opt_fixed_video_dir ? "grey-text" : ""}>
                        {show_root_dir ? <div style="word-wrap:break-word"><span>{translate("Incoming")}:&nbsp;&nbsp;</span><span>{root_dir}</span></div> : ""}
                        <div style="word-wrap:break-word"><span>{translate(show_root_dir ? "Outgoing" : "Directory")}:&nbsp;&nbsp;</span><span #folderPath>{user_dir}</span></div>
                        {is_opt_fixed_video_dir ? "" : <div> <button #select_directory .link>{translate('Change')}</button> </div>}
                    </div>
                </div>
                , "", function(res=null) {
                if (!res) return;
                if (!is_opt_fixed_enable_record) handler.set_option("enable-record-session", res.enable_record_session ? default_option_yes : 'N');
                if (!is_opt_fixed_auto_incoming) handler.set_option("allow-auto-record-incoming", res.auto_record_incoming ? 'Y' : default_option_no);
                if (!is_opt_fixed_auto_outgoing) handler.set_local_option("allow-auto-record-outgoing", res.auto_record_outgoing ? 'Y' : default_option_no);
                if (!is_opt_fixed_video_dir) handler.set_local_option("video-save-directory", $(#folderPath).text);
            }, msgbox_default_height, get_msgbox_width());
        }
        this.toggleMenuState();
    }
}

function getUserName() {
    try {
        return JSON.parse(handler.get_local_option("user_info")).name;
    } catch(e) {}
    return '';
}

function getAccountLabelWithHandle() {
    try {
        var user = JSON.parse(handler.get_local_option("user_info"));
        var username = (user.name || '').trim();
        if (!username) {
            return '';
        }
        var displayName = (user.display_name || '').trim();
        if (!displayName || displayName == username) {
            return username;
        }
        return displayName + " (@" + username + ")";
    } catch(e) {}
    return '';
}

// TBFDesk: split accessors for the signed-in account bar (App.render) so the
// display name can be highlighted and the @handle shown subtly beneath it.
// Defined here (well above the App mount) so App.render can call them safely.
function nemoAccountName() {
    try {
        var user = JSON.parse(handler.get_local_option("user_info"));
        var dn = (user.display_name || '').trim();
        var un = (user.name || '').trim();
        return dn || un;
    } catch(e) {}
    return '';
}

function nemoAccountHandle() {
    try {
        var user = JSON.parse(handler.get_local_option("user_info"));
        var un = (user.name || '').trim();
        var dn = (user.display_name || '').trim();
        return (un && dn && dn != un) ? ("@" + un) : '';
    } catch(e) {}
    return '';
}

// Shared dialog functions
function open_custom_server_dialog() {
    if (nemoExeServerSettingsLocked()) {
        msgbox("custom-nocancel-nook-hasclose", "ID/Relay Server",
            "<div style='line-height: 2em'>" +
            "Server settings are locked by this executable name." +
            handler.get_license() +
            "</div>",
            "", function() {}, 260, get_msgbox_width());
        return;
    }
    if (nemoManagementServerSettingsLocked()) {
        msgbox("custom-nocancel-nook-hasclose", "ID/Relay Server",
            "<div style='line-height: 2em'>Server settings are locked by management policy.</div>",
            "", function() {}, 220, get_msgbox_width());
        return;
    }
    var configOptions = handler.get_options();
    var old_relay = configOptions["relay-server"] || "";
    var old_api = configOptions["api-server"] || "";
    var old_id = configOptions["custom-rendezvous-server"] || "";
    var old_key = configOptions["key"] || "";
    var old_company_only = configOptions[nemo_company_network_only_option] == "Y";
    var company_only_attrs = old_company_only ? { checked: true } : {};
    msgbox("custom-server", "ID/Relay Server",
            <div .form .set-password>
                <div><span>{translate("ID Server")}: </span><input|text .outline-focus name='id' value={old_id} /></div>
                <div><span>{translate("Relay Server")}: </span><input|text name='relay' value={old_relay} /></div>
                <div><span>{translate("API Server")}: </span><input|text name='api' value={old_api} /></div>
                <div><span>{translate("Key")}: </span><input|text name='key' value={old_key} /></div>
                {nemo_gui_server_settings ? <div><button|checkbox(company_only) {company_only_attrs}>Company network only</button></div> : ""}
                {nemo_gui_server_settings ? <div style="font-size: 0.9em; color: #888; line-height: 1.4em;">Blocks public network IDs such as id@public. Clear ID Server and uncheck this to use the public network again.</div> : ""}
            </div>,
            "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                var id = (res.id || "").trim();
                var relay = (res.relay || "").trim();
                var api = (res.api || "").trim().toLowerCase();
                var key = (res.key || "").trim();
                var company_only = res.company_only ? true : false;
                if (company_only && !id) {
                    if (typeof show_progress === 'function') show_progress(false, "Company network only requires an ID server");
                    return;
                }
                if (id == old_id && relay == old_relay && key == old_key && api == old_api && company_only == old_company_only) return;
                if (id) {
                    var err = handler.test_if_valid_server(id, true);
                    if (err) { if (typeof show_progress === 'function') show_progress(false, translate("ID Server") + ": " + err); return; }
                }
                if (relay) {
                    var err = handler.test_if_valid_server(relay, true);
                    if (err) { if (typeof show_progress === 'function') show_progress(false, translate("Relay Server") + ": " + err); return; }
                }
                if (api) {
                    if (0 != api.indexOf("https://") && 0 != api.indexOf("http://")) {
                        if (typeof show_progress === 'function') show_progress(false, translate("API Server") + ": " + translate("invalid_http"));
                        return;
                    }
                }
                configOptions["custom-rendezvous-server"] = id;
                configOptions["relay-server"] = relay;
                configOptions["api-server"] = api;
                configOptions["key"] = key;
                configOptions[nemo_company_network_only_option] = company_only ? "Y" : "";
                handler.set_options(configOptions);
                if (typeof show_progress === 'function') show_progress(-1);
            }, 330, get_msgbox_width());
}

function open_nemo_management_dialog() {
    var configOptions = handler.get_options();
    var old_enabled = configOptions[nemo_management_enabled_option] == "Y";
    var old_server = configOptions[nemo_management_server_option] || "";
    var old_public_key = configOptions[nemo_management_public_key_option] || "";
    var enabled_attrs = old_enabled ? { checked: true } : {};
    msgbox("custom-server", "Management",
            <div .form .set-password>
                <div><span>Management Server: </span><input|text .outline-focus name='server' value={old_server} /></div>
                <div><span>Public Key: </span><input|text name='public_key' value={old_public_key} /></div>
                <div><button|checkbox(enabled) {enabled_attrs}>Enable management control</button></div>
            </div>,
            "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                var enabled = res.enabled ? true : false;
                var server = (res.server || "").trim();
                var public_key = (res.public_key || "").trim();
                if (enabled && !server) {
                    if (typeof show_progress === 'function') show_progress(false, "Management Server is required");
                    return;
                }
                if (server && 0 != server.indexOf("https://") && 0 != server.indexOf("http://")) {
                    if (typeof show_progress === 'function') show_progress(false, "Management Server: " + translate("invalid_http"));
                    return;
                }
                if (enabled == old_enabled && server == old_server && public_key == old_public_key) return;
                configOptions[nemo_management_enabled_option] = enabled ? "Y" : "";
                configOptions[nemo_management_server_option] = server;
                configOptions[nemo_management_public_key_option] = public_key;
                handler.set_options(configOptions);
                if (typeof show_progress === 'function') show_progress(-1);
            }, 330, get_msgbox_width());
}

function open_nemo_alias_dialog() {
    var is_fixed = handler.is_option_fixed("nemo-alias");
    var old_alias = handler.get_option("nemo-alias") || "";
    msgbox("custom-server", "Alias",
            <div .form .set-password>
                <div><span>{translate('Alias')}: </span><input|text .outline-focus name='alias' value={old_alias} /></div>
                {is_fixed ? <div style="margin-top:6px;opacity:0.7">{translate('This value is managed by your administrator.')}</div> : ""}
            </div>,
            "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                if (is_fixed) { if (typeof show_progress === 'function') show_progress(-1); return; }
                var alias = (res.alias || "").trim();
                if (alias == old_alias) { if (typeof show_progress === 'function') show_progress(-1); return; }
                handler.set_option("nemo-alias", alias);
                if (typeof show_progress === 'function') show_progress(-1);
            }, 200, get_msgbox_width());
}

// S-DUALKEY: import the private device key generated on the TBFDesk server, so
// this client authenticates to the server with its own key. Saved to config
// (nemo-device-key); the poll signs with it.
function open_import_device_key_dialog() {
    var cur = handler.get_option("nemo-device-key") || "";
    msgbox("custom-server", translate("Import device key"),
            <div .form .set-password>
                <div><span>{translate('Device key')}: </span><input|text .outline-focus name='devkey' value={cur} /></div>
                <div style="margin-top:6px;opacity:0.7;font-size:0.9em">{translate('Paste the private key generated on your TBFDesk server. Leave empty to remove.')}</div>
            </div>,
            "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                handler.set_option("nemo-device-key", (res.devkey || "").trim());
                if (typeof show_progress === 'function') show_progress(-1);
            }, 200, get_msgbox_width());
}

function open_whitelist_dialog() {
    var is_opt_fixed = handler.is_option_fixed("whitelist");
    var v = handler.get_option("whitelist");
    var old_value = v == default_option_whitelist ? '' : v.split(",").join("\n");
    var type_str = is_opt_fixed ? "custom-whitelist-nook" : "custom-whitelist";
    var readonly_attr = is_opt_fixed ? " readonly=\"readonly\"" : "";
    var grey_class = is_opt_fixed ? " class=\"grey-text\"" : "";
    msgbox(type_str, translate("IP Whitelisting"), "<div .form> \
            <div" + grey_class + ">" + translate("whitelist_sep") + "</div> \
            <textarea .outline-focus spellcheck=\"false\" name=\"text\" novalue=\"0.0.0.0\"" + readonly_attr + grey_class + " style=\"overflow: scroll-indicator; width:*; height: 140px; font-size: 1.2em; padding: 0.5em;\">" + old_value + "</textarea>\
            </div> \
            ", "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                var value = (res.text || "").trim();
                if (value) {
                    var values = value.split(/[\s,;\n]+/g);
                    for (var ip in values) {
                        if (!ip.match(/^(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?|0)\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?|0)\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?|0)\.(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]?|0)(\/([1-9]|[1-2][0-9]|3[0-2])){0,1}$/)
                            && !ip.match(/^(((?:[0-9A-Fa-f]{1,4}))*((?::[0-9A-Fa-f]{1,4}))*::((?:[0-9A-Fa-f]{1,4}))*((?::[0-9A-Fa-f]{1,4}))*|((?:[0-9A-Fa-f]{1,4}))((?::[0-9A-Fa-f]{1,4})){7})(\/([1-9]|[1-9][0-9]|1[0-1][0-9]|12[0-8])){0,1}$/)) {
                            if (typeof show_progress === 'function') show_progress(false, translate("Invalid IP") + ": " + ip);
                            return;
                        }
                    }
                    value = values.join("\n");
                }
                if (value == old_value) return;
                if (!value) value = default_option_whitelist;
                handler.set_option("whitelist", value.replace("\n", ","));
                if (typeof show_progress === 'function') show_progress(-1);
            }, 300, get_msgbox_width());
}

function open_proxy_dialog() {
    var is_opt_fixed = handler.is_option_fixed("proxy-url");
    var socks5 = handler.get_socks() || {};
    var old_proxy = socks5[0] || "";
    var old_username = socks5[1] || "";
    var old_password = socks5[2] || "";
    var type_str = is_opt_fixed ? "custom-server-nook" : "custom-server";
    var greyStyle = is_opt_fixed ? grey_text_style : "";
    msgbox(type_str, "Socks5/Http(s) Proxy", <div .form .set-password>
            <div><span style={greyStyle}>{translate("Server")}:</span><input|text .outline-focus style={greyStyle} name='proxy' value={old_proxy} disabled={ is_opt_fixed ? "true" : "false" } /></div>
            <div><span style={greyStyle}>{translate("Username")}:</span><input|text style={greyStyle} name='username' value={old_username} disabled={ is_opt_fixed ? "true" : "false" } /></div>
            <div><span style={greyStyle}>{translate("Password")}:</span>{ is_opt_fixed ? <input|password style={grey_text_style} name='password' value={old_password} disabled="true" /> : <PasswordComponent value={old_password} /> }</div>
            </div>
            , "", function(res=null, show_progress) {
                if (!res) return;
                if (typeof show_progress === 'function') show_progress();
                var proxy = (res.proxy || "").trim();
                var username = (res.username || "").trim();
                var password = (res.password || "").trim();
                if (proxy == old_proxy && username == old_username && password == old_password) return;
                if (proxy) {
                    var domain_port = proxy;
                    var protocol_index = domain_port.indexOf('://');
                    if (protocol_index !== -1) {
                        domain_port = domain_port.substring(protocol_index + 3);
                    }
                    var err = handler.test_if_valid_server(domain_port, false);
                    if (err) { if (typeof show_progress === 'function') show_progress(false, translate("Server") + ": " + err); return; }
                }
                handler.set_socks(proxy, username, password);
                if (typeof show_progress === 'function') show_progress(-1);
            }, 240, get_msgbox_width());
}

function updateTheme() {
    var root_element = self;
    if (handler.get_option("allow-darktheme") == "Y") {
        // enable dark theme
        root_element.attributes.toggleClass("darktheme", true);
    } else {
        // disable dark theme
        root_element.attributes.toggleClass("darktheme", false);
    }
}

class MyIdMenu: Reactor.Component {
    function this() {
        myIdMenu = this;
    }

    function render() {
        // The "..." settings button was moved OUT of the ID field to the
        // "Your Desktop" title (see App.render #open-settings). This still holds
        // the hidden #config-options popup that the Settings dialog reuses for its
        // Audio/Enhancements/Language fly-outs.
        return <div #myid>
            {this.renderPop()}
            ID
        </div>;
    }

    function renderPop() {
        var accountLabel = handler.get_local_option("access_token") ? getAccountLabelWithHandle() : '';
        return <popup>
            <menu.context #config-options>
                {!disable_settings && <li #enable-keyboard><span>{svg_checkmark}</span>{translate('Enable keyboard/mouse')}</li>}
                {!disable_settings && <li #enable-clipboard><span>{svg_checkmark}</span>{translate('Enable clipboard')}</li>}
                {!disable_settings && <li #enable-file-transfer><span>{svg_checkmark}</span>{translate('Enable file transfer')}</li>}
                {!disable_settings && <li #enable-camera><span>{svg_checkmark}</span>{translate('Enable camera')}</li>}
                {!disable_settings && <li #enable-terminal><span>{svg_checkmark}</span>{translate('Enable terminal')}</li>}
                {!disable_settings && <li #enable-remote-restart><span>{svg_checkmark}</span>{translate('Enable remote restart')}</li>}
                {!disable_settings && <li #enable-tunnel><span>{svg_checkmark}</span>{translate('Enable TCP tunneling')}</li>}
                {!disable_settings && is_win ? <li #enable-block-input><span>{svg_checkmark}</span>{translate('Enable blocking user input')}</li> : ""}
                {!disable_settings && (handler.get_supported_privacy_mode_impls() != '[]') && <li #enable-privacy-mode><span>{svg_checkmark}</span>{translate('Enable privacy mode')}</li>}
                {!disable_settings && <li #enable-lan-discovery><span>{svg_checkmark}</span>{translate('Enable LAN discovery')}</li>}
                <AudioInputs />
                <Enhancements />
                {!disable_settings && <li #allow-remote-config-modification><span>{svg_checkmark}</span>{translate('Enable remote configuration modification')}</li>}
                {!disable_settings && <div .separator />}
                {!disable_settings && !hide_server_settings && <li #custom-server>{translate('ID/Relay Server')}{(nemoExeServerSettingsLocked() || nemoManagementServerSettingsLocked()) ? " (locked)" : ""}</li>}
                {!disable_settings && !hide_server_settings && nemo_management_settings && <li #nemo-management>Management</li>}
                {!disable_settings && nemo_management_settings && <li #nemo-alias>{translate('Alias')}</li>}
                {!disable_settings && <li #import-device-key>{translate('Import device key')}</li>}
                {!disable_settings && <li #whitelist title={translate('whitelist_tip')}>{translate('IP Whitelisting')}</li>}
                {!disable_settings && !hide_proxy_settings && <li #socks5-server>{translate('Socks5/Http(s) Proxy')}</li>}
                {!disable_settings && !hide_websocket_settings && <li #allow-websocket><span>{svg_checkmark}</span>{translate('Use WebSocket')}</li>}
                {!disable_settings && !using_public_server && !outgoing_only && <li #disable-udp class={disable_udp ? "selected" : "line-through"}><span>{svg_checkmark}</span>{translate('Disable UDP')}</li>}
                {!disable_settings && !using_public_server && <li #allow-insecure-tls-fallback><span>{svg_checkmark}</span>{translate('Allow insecure TLS fallback')}</li>}
                <div .separator />
                {(!hide_stop_service || service_stopped) && <li #stop-service class={service_stopped ? "line-through" : "selected"}><span>{svg_checkmark}</span>{translate("Enable service")}</li>}
                {!disable_settings && is_win && handler.is_installed() ? <ShareRdp /> : ""}
                {!disable_settings && <DirectServer />}
                {!disable_settings && false && handler.using_public_server() && <li #allow-always-relay><span>{svg_checkmark}</span>{translate('Always connect via relay')}</li>}
                {!disable_change_id && handler.is_ok_change_id() ? <div .separator /> : ""}
                {!disable_account && (accountLabel ?
                <li #logout>{translate('Logout')} ({accountLabel})</li> :
                <li #login>{translate('Login')}</li>)}
                {!disable_change_id && !disable_settings && handler.is_ok_change_id() && key_confirmed && connect_status > 0 ? <li #change-id>{translate('Change ID')}</li> : ""}
                <div .separator />
                <li #allow-darktheme><span>{svg_checkmark}</span>{translate('Dark Theme')}</li>
                <Languages />
                {disable_installation ? "" : <li #allow-auto-update><span>{svg_checkmark}</span>{translate('Auto update')}</li>} 
                <li #about>{translate('About') + " TBFDesk"}</li>
            </menu>
        </popup>;
    }

    event click $(svg#menu) (_, me) {
        // TBFDesk: open the new modal Settings dialog instead of the native popup.
        nemoOpenSettingsDialog();
    }

    function showSettingMenu() {
        audioInputMenu.update({ show: true });
        this.toggleMenuState();
        if (direct_server) direct_server.update();
        var menu = this.$(menu#config-options);
        this.$(svg#menu).popup(menu);
    }

    event click $(li#login) () {
        login();
    }

    event click $(li#logout) () {
        logout();
    }

    function toggleMenuState() {
        for (var el in $$(menu#config-options>li)) {
            var id = el.id;
            if (!id) continue;
            var is_opt_fixed = handler.is_option_fixed(id);
            if (id.indexOf("enable-") == 0) {
                var enabled = handler.get_option(id) != "N";
                el.attributes.toggleClass("selected", enabled);
                el.attributes.toggleClass("line-through", !enabled);
            } else if (id.indexOf("allow-") == 0) {
                var enabled = handler.get_option(id) == "Y";
                el.attributes.toggleClass("selected", enabled);
                el.attributes.toggleClass("line-through", !enabled);
            } else if (id == "whitelist") {
                // whitelist should be clickable even when fixed (to view the content)
                // The dialog will show readonly textarea and no OK button when fixed
                continue;
            }
            if (is_opt_fixed) {
                el.state.disabled = true;
            }
        }
    }

    function showAbout() {
        var name = "TBFDesk";  // display name only; APP_NAME stays "RustDesk" (config dir)
        msgbox("custom-nocancel-nook-hasclose", translate("About") + " " + name, "<div style='line-height: 2em'> \
            <div>Version: " + handler.get_version() + " \
            <div>Fingerprint: " + handler.get_fingerprint() + " \
            <div .link .custom-event url='https://rustdesk.com/privacy.html'>" + translate("Privacy Statement") + "</div> \
            <div .link .custom-event url='https://rustdesk.com'>" + translate("Website") + "</div> \
	    <div style='background: #2c8cff; color: white; padding: 1em; margin-top: 1em;'>Copyright &copy; 2025 Purslane Ltd.\
            <br />" + handler.get_license() + " \
            <p style='font-weight: bold'>" + translate("Slogan_tip") + "</p>\
            </div>\
        </div>", "", function(el) {
            if (el && el.attributes) {
                handler.open_url(el.attributes['url']);
            };
        }, 400, get_msgbox_width());
    }

    event click $(menu#config-options>li) (_, me) {
        if (me.state.disabled) return;
        if (me.id && me.id.indexOf("enable-") == 0) {
            handler.set_option(me.id, handler.get_option(me.id) == "N" ? default_option_yes : "N");
        }
        if (me.id && me.id.indexOf("allow-") == 0) {
            handler.set_option(me.id, handler.get_option(me.id) == "Y" ? default_option_no : "Y");
        }
        if (me.id == "whitelist") {
            open_whitelist_dialog();
        } else if (me.id == "custom-server") {
            open_custom_server_dialog();
        } else if (me.id == "nemo-management") {
            open_nemo_management_dialog();
        } else if (me.id == "nemo-alias") {
            open_nemo_alias_dialog();
        } else if (me.id == "import-device-key") {
            open_import_device_key_dialog();
        } else if (me.id == "socks5-server") {
            open_proxy_dialog();
        } else if (me.id == "disable-udp") {
            handler.set_option("disable-udp", handler.get_option("disable-udp") == "Y" ? "N" : "Y");
        } else if (me.id == "stop-service") {
            handler.set_option("stop-service", service_stopped ? default_option_no : "Y");
        } else if (me.id == "change-id") {
            var id_label_width = incoming_only ? "50px" : "100px";
            var input_width = incoming_only ? (incoming_only_width - 20) + "px" : "250px";
            msgbox("custom-id", translate("Change ID"), "<div .form .set-password> \
            <div>" + translate('id_change_tip') + " </div> \
            <div><span style='width: " + id_label_width + "; display:inline-block'>ID: </span><input|text .outline-focus style='width: " + input_width + "' name='id' /></div> \
            </div> \
            ", "", function(res=null, show_progress) {
                if (!res) return;
                show_progress();
                var id = (res.id || "").trim();
                if (!id) return;
                if (id == my_id) return;
                handler.change_id(id);
                function check_status() {
                    var status = handler.get_async_job_status();
                    if (status == " ") self.timer(0.1s, check_status);
                    else {
                        if (status) show_progress(false, translate(status));
                        else show_progress(-1);
                    }
                }
                check_status();
                return " ";
            }, msgbox_default_height, get_msgbox_width());
        } else if (me.id == "allow-darktheme") {
            updateTheme();
        } else if (me.id == "about") {
            this.showAbout()
        }
    }
}

var is_edit_direct_access_port;
class EditDirectAccessPort: Reactor.Component {
    function render() {
        return <span style="margin-left: 12px; padding: 0 6px; display: inline-block;" .link>{svg_edit}</span>;
    }

    function onMouse(evt) {
        if (evt.type == Event.MOUSE_DOWN) {
            is_edit_direct_access_port = true;
            editDirectAccessPort();
        }
    }
}

function editDirectAccessPort() {
    var is_opt_fixed = handler.is_option_fixed("direct-access-port");
    var p0 = handler.get_option('direct-access-port');
    var greyStyle = is_opt_fixed ? grey_text_style : "";
    var port = p0 ? <input|text style={greyStyle} name='port' value={p0} disabled={is_opt_fixed ? "true" : "false"} /> :
                    <input|text style={greyStyle} name='port' novalue={21118} disabled={is_opt_fixed ? "true" : "false"} />;
    var type_str = is_opt_fixed ? "custom-direct-access-port-nook" : "custom-direct-access-port";
    msgbox(type_str, translate('Direct IP Access Settings'), <div .form .set-password>
            <div><span style={"width: 60px;" + greyStyle}>{translate('Port')}:</span>{port}</div>
        </div>, "", function(res=null) {
        if (!res) return;
        var p = (res.port || '').trim();
        if (p) {
            p = p.toInteger();
            if (!(p > 0)) {
                return translate("Invalid port");
            }
            p = p + '';
        }
        if (p != p0) handler.set_option('direct-access-port', p);
      }, msgbox_default_height, get_msgbox_width());
}

// Whether the login-first modal has been auto-opened for the current gate render.
var nemoGateShown = false;
// Last gate visibility we rendered (null = unknown), so the watcher only forces a
// re-render on an actual transition (shown<->hidden) instead of every tick.
var nemoLastGate = null;
var nemoLastAbVersion = null;   // #3-push: last server address-book version seen

// Identity-based access helpers. These MUST be defined before class App: App is
// mounted below via $(body).content(<App/>), and its render() calls these on the
// very first paint. TIScript runs top-level definitions in source order (no
// hoisting), so defining them later in the file leaves them `undefined` at first
// render — which throws "Wrong type - undefined, expected instance of function"
// in App.render and blanks the whole window.
function nemoLoginRequired() {
    return handler.get_option("nemo-require-login") == "Y";
}
function nemoIsLoggedIn() {
    return !!handler.get_local_option("access_token");
}
// TBFDesk: server address shown/edited on the login gate. Pre-fills with the
// current api-server (or the ID server host if no api-server is set).
function nemoGateServerValue() {
    var opts = handler.get_options();
    return (opts["api-server"] || opts["custom-rendezvous-server"] || "").trim();
}
// Derive the ID host and api-server URL from a user-typed server value.
// Accepts a bare host ("tbfdesk.example.com" -> https://host:21120) or a full
// http(s):// URL.
function nemoDeriveApiUrl(val) {
    val = (val || "").trim();
    var host = val, api = val;
    if (val.indexOf("http://") == 0 || val.indexOf("https://") == 0) {
        api = val;
        var rest = val.substr(val.indexOf("://") + 3);
        var slash = rest.indexOf("/");
        if (slash >= 0) rest = rest.substr(0, slash);
        var colon = rest.indexOf(":");
        host = colon >= 0 ? rest.substr(0, colon) : rest;
    } else {
        var colon = val.indexOf(":");
        host = colon >= 0 ? val.substr(0, colon) : val;
        api = "https://" + val + (colon >= 0 ? "" : ":21120");
    }
    return { host: host, api: api };
}

// Apply + SAVE the gate's server field before login: sets the ID/rendezvous
// server (host), the api-server (login + address book), and the management
// server (signed policy poll) all from one address.
function nemoApplyGateServer(val) {
    val = (val || "").trim();
    if (!val) return;
    var d = nemoDeriveApiUrl(val);
    var opts = handler.get_options();
    opts["custom-rendezvous-server"] = d.host;
    opts["api-server"] = d.api;
    opts[nemo_management_server_option] = d.api;
    handler.set_options(opts);
    // Seed the accept-self-signed default the first time only (see below).
    nemoInitInsecureTlsDefault();
}

// --- Insecure-TLS (self-signed cert) control on the login gate ---------------
// The TBFDesk API serves a self-signed certificate. Accepting it lets login work
// while the password stays confidential (sealed to the server's NaCl key, S-B).
// The user may allow/disallow this per client with a checkbox, UNLESS an admin
// policy manages the option (then it is shown read-only).
function nemoInsecureTlsValue() {
    return (handler.get_option("allow-insecure-tls-fallback") || "").trim() == "Y";
}
function nemoInsecureTlsManaged() {
    return handler.is_option_fixed("allow-insecure-tls-fallback");
}
function nemoInsecureTlsAttrs() {
    return nemoInsecureTlsValue() ? { checked: true } : {};
}
// First-run default: with no explicit choice yet, allow the self-signed cert so
// login works out of the box. Never overrides an explicit Y/N the user set, nor
// an admin-managed value.
function nemoInitInsecureTlsDefault() {
    if (nemoInsecureTlsManaged()) return;
    var cur = (handler.get_option("allow-insecure-tls-fallback") || "").trim();
    if (cur == "") {
        var opts = handler.get_options();
        opts["allow-insecure-tls-fallback"] = "Y";
        handler.set_options(opts);
    }
}
function nemoToggleInsecureTls() {
    if (nemoInsecureTlsManaged()) return;
    var next = !nemoInsecureTlsValue();
    var opts = handler.get_options();
    opts["allow-insecure-tls-fallback"] = next ? "Y" : "N";
    handler.set_options(opts);
    var el = $(#gate-insecure-tls);
    if (el) el.state.checked = next;
    nemoRefreshCertInfo();
}

// The api-server URL to probe: the (possibly unsaved) gate field first, else the
// currently configured api-server.
function nemoGateApiUrl() {
    var el = $(#gate-server);
    var val = el ? (el.value || "") : "";
    val = val.trim();
    if (val) return nemoDeriveApiUrl(val).api;
    return (handler.get_api_server() || "").trim();
}
// Fetch the server's certificate summary and render it into the gate info box.
// Uses an accept-invalid probe (handler.nemo_cert_info_start) so the certificate
// ALWAYS shows — even when the user has strict TLS on — because seeing the cert
// is how they decide whether to trust it. Non-blocking: we poll the result and
// animate the dots so the wait never looks frozen.
// Certificate probe state, cached per server URL. App.render() builds the box
// from this state (nemoCertBoxVnode) so the panel survives Reactor re-renders
// instead of flickering away. The cert is downloaded ONCE per server; toggling
// the checkbox only recomputes the local hint from the cache (no re-download).
var nemoCertData = null;      // parsed /api/tls-cert-info JSON (includes .pem)
var nemoCertErr = null;       // probe error text
var nemoCertUrl = "";         // server URL the cache belongs to
var nemoCertProbing = false;
var nemoCertDotN = 0;
// Trigger a probe, or reuse the cache when we already have this server's cert
// (e.g. the user only toggled the checkbox). force=true always re-downloads.
function nemoRefreshCertInfo(force = false) {
    var url = nemoGateApiUrl();
    if (!url) { nemoCertData = null; nemoCertErr = null; nemoCertUrl = ""; nemoCertProbing = false; if (app) app.update(); return; }
    if (!force && url == nemoCertUrl && (nemoCertData || nemoCertErr)) { if (app) app.update(); return; }
    nemoCertData = null; nemoCertErr = null; nemoCertUrl = url; nemoCertProbing = true; nemoCertDotN = 0;
    handler.nemo_cert_info_start(url + "/api/tls-cert-info");
    if (app) app.update();      // show the animated pending state
    nemoCertPoll();
}
function nemoCertPoll() {
    if (!nemoCertProbing) return;
    var status = handler.nemo_cert_info_result();
    if (status == " " || status == "") {          // in flight -> animate the dots
        nemoCertDotN = (nemoCertDotN % 3) + 1;     // 1,2,3,1,2,3 ...
        var box = $(#gate-cert-info);
        if (box) {
            var dots = ""; for (var i = 0; i < nemoCertDotN; ++i) dots += ".";
            box.text = translate("Checking server certificate") + dots;
        }
        $(body).timer(350ms, nemoCertPoll);        // body is stable across re-renders
        return;
    }
    var info = null;
    try { info = JSON.parse(status); } catch (e) { info = null; }
    if (!info || info.error) { nemoCertErr = info ? ("" + info.error) : status; nemoCertData = null; }
    else { nemoCertData = info; nemoCertErr = null; }
    nemoCertProbing = false;
    if (app) app.update();       // reactive render -> the panel now persists
}
// Group the SHA-256 fingerprint into 8-byte runs separated by spaces so the long
// hash wraps inside the narrow box (and stays easy to read/verify by hand).
function nemoFmtFp(fp) {
    if (!fp) return "";
    var parts = fp.split(":");
    var out = "";
    for (var i = 0; i < parts.length; ++i) {
        out += parts[i];
        if (i < parts.length - 1) out += (((i + 1) % 8 == 0) ? " " : ":");
    }
    return out;
}
// Save the server certificate (PEM) to a file the user chooses.
function nemoDownloadCert() {
    if (!nemoCertData || !nemoCertData.pem) return;
    var host = nemoCertData.server_host || "tbfdesk";
    var initialPath = System.path(#USER_DOCUMENTS, "tbfdesk-" + host);
    var url = view.selectFile(#save, "Certificate (*.crt)", "crt", initialPath, translate("Save certificate"));
    if (!url) return;
    handler.nemo_save_text_file(URL.toPath(url), nemoCertData.pem);
}
// Pure: build the certificate info box from the cached probe state + the current
// checkbox value. Called by App.render(), so it survives re-renders.
function nemoCertBoxVnode() {
    var boxBase = "display:block; margin-top:16px; padding:10px 12px; border-radius:6px; font-size:11px; line-height:1.5em";
    if (nemoCertProbing || (!nemoCertData && !nemoCertErr)) {
        var pd = ""; for (var k = 0; k < (nemoCertDotN > 0 ? nemoCertDotN : 3); ++k) pd += ".";
        var pst = boxBase + "; border:1px solid #e2e6ea; background:#f6f8fa; color:#556";
        return <div #gate-cert-info style={pst}>{translate("Checking server certificate") + pd}</div>;
    }
    var bg = "#f6f8fa", bd = "#e2e6ea", fg = "#556";
    var title = "", lines = [], hint = "";
    var info = nemoCertData;
    if (info && info.tls) {
        if (info.self_signed) {
            if (nemoInsecureTlsValue()) {
                // ORANGE: self-signed accepted -> encrypted but not OS-verified.
                bg = "#fff8e6"; bd = "#f0d98c"; fg = "#8a6d1a";
                title = translate("Self-signed certificate - allowed, encrypted but not verified by your OS");
                hint = translate("This is normal for TBFDesk and safe. Your password stays sealed end-to-end. To remove this warning, install a CA-signed certificate and check the fingerprint matches your server.");
            } else {
                // RED: self-signed rejected -> sign-in will fail.
                bg = "#fdecea"; bd = "#f3b6ae"; fg = "#b42318";
                title = translate("Self-signed certificate - not allowed, sign-in will fail");
                hint = translate("Insecure TLS is off, so signing in to this self-signed server will fail. Tick 'Allow insecure TLS' above to sign in (your password stays sealed), or install a CA-signed certificate.");
            }
        } else {
            // GREEN: CA-signed, verifiable by the OS trust store.
            bg = "#eef8f0"; bd = "#b7dfc0"; fg = "#1a7a34";
            title = translate("Certificate verified - secure connection");
            hint = translate("This certificate is issued by a trusted authority. You can turn off 'Allow insecure TLS'.");
        }
        if (info.subject) lines.push(translate("Subject") + ": " + info.subject);
        if (info.issuer && info.issuer != info.subject) lines.push(translate("Issuer") + ": " + info.issuer);
        if (info.sans && info.sans.length) lines.push(translate("Names") + ": " + info.sans.join(", "));
        if (info.fingerprint) lines.push(translate("Fingerprint (SHA-256)") + ": " + nemoFmtFp(info.fingerprint));
        if (info.not_after) lines.push(translate("Valid until") + ": " + info.not_after);
        lines.push(nemoInsecureTlsValue() ? translate("Insecure TLS is currently allowed") : translate("Insecure TLS is currently blocked"));
    } else if (info && !info.tls) {
        bg = "#fdecea"; bd = "#f3b6ae"; fg = "#b42318";
        title = translate("The server is not using TLS");
        hint = translate("Credentials would travel unencrypted. Enable TLS on the TBFDesk server (--nemo-api-tls auto).");
    } else {
        bg = "#fdecea"; bd = "#f3b6ae"; fg = "#b42318";
        title = translate("Could not verify the server certificate");
        if (nemoCertErr) lines.push(nemoCertErr);
        hint = translate("If this is your TBFDesk server with a self-signed certificate, tick 'Allow insecure TLS' above. For production, install a CA-signed certificate.");
    }
    var text = title;
    for (var j = 0; j < lines.length; ++j) text += "\n" + lines[j];
    if (hint) text += "\n\n" + hint;
    var boxSt = boxBase + "; border:1px solid " + bd + "; background:" + bg + "; color:" + fg;
    var textSt = "display:block; white-space:pre-wrap; word-wrap:break-word; overflow-wrap:break-word; overflow-x:hidden";
    var dlSt = "display:block; margin-top:8px; color:" + fg + "; text-decoration:underline; cursor:pointer";
    return <div #gate-cert-info style={boxSt}>
        <div style={textSt}>{text}</div>
        {(info && info.pem) ? <div #gate-cert-download style={dlSt}>{translate("Download certificate")}</div> : ""}
    </div>;
}

// ============================================================================
// TBFDesk: modal Settings dialog. Replaces the cramped native <menu#config-options>
// context-menu popup opened from the "..." (svg#menu) button with a centered,
// dismissable modal that lays the SAME options out in sectioned cards / columns.
//
// The original <menu#config-options> is KEPT in MyIdMenu's <popup> (hidden) and
// is used ONLY as the live SOURCE for the three real sub-menus (Audio Input,
// Enhancements, Language): those are popped as fly-outs anchored to their rows in
// this dialog (popupSub). Every other option (permission/allow toggles + action
// buttons + Direct-IP + RDP sharing) is rendered directly in this grid, so its
// live state and clicks are handled by THIS component. Defined ABOVE class App
// because App.render() mounts <NemoSettingsDialog/> (no hoisting in TIScript).
// ============================================================================
var nemoSettingsDialog;

// Change-ID modal, factored out of MyIdMenu's native click handler so the new
// dialog can reuse the exact same flow.
function nemoChangeIdDialog() {
    var id_label_width = incoming_only ? "50px" : "100px";
    var input_width = incoming_only ? (incoming_only_width - 20) + "px" : "250px";
    msgbox("custom-id", translate("Change ID"), "<div .form .set-password> \
    <div>" + translate('id_change_tip') + " </div> \
    <div><span style='width: " + id_label_width + "; display:inline-block'>ID: </span><input|text .outline-focus style='width: " + input_width + "' name='id' /></div> \
    </div> \
    ", "", function(res=null, show_progress) {
        if (!res) return;
        show_progress();
        var id = (res.id || "").trim();
        if (!id) return;
        if (id == my_id) return;
        handler.change_id(id);
        function check_status() {
            var status = handler.get_async_job_status();
            if (status == " ") self.timer(0.1s, check_status);
            else {
                if (status) show_progress(false, translate(status));
                else show_progress(-1);
            }
        }
        check_status();
        return " ";
    }, msgbox_default_height, get_msgbox_width());
}

// Password actions, callable from the Settings dialog's Password section (the
// PasswordArea keeps its own native menu handlers untouched).
function nemoRefreshPwUi() {
    if (passwordArea) passwordArea.update();
    if (nemoSettingsDialog && nemoSettingsDialog.shown) nemoSettingsDialog.update();
}

function nemoSetPasswordDialog() {
    var has_local_password = handler.is_local_permanent_password_set();
    var permanent_password_set = handler.is_permanent_password_set();
    var password_tip = "";
    if (has_local_password) {
        password_tip = "<div style='margin-top:0.5em; color:#e5a43a;'><span style='font-weight:bold;'>[!]</span> " + translate('password-hidden-tip') + "</div>";
    } else if (permanent_password_set) {
        password_tip = "<div style='margin-top:0.5em; color:#e5a43a;'><span style='font-weight:bold;'>[!]</span> " + translate('preset-password-in-use-tip') + "</div>";
    }
    msgbox("custom-password", translate("Set Password"), "<div .form .set-password> \
        <div><span>" + translate('Password') + ":</span><input|password(password) .outline-focus /></div> \
        <div><span>" + translate('Confirmation') + ":</span><input|password(confirmation) /></div> \
        " + password_tip + " \
    </div> \
    ", "", function(res=null) {
        if (!res) return;
        var p0 = (res.password || "").trim();
        var p1 = (res.confirmation || "").trim();
        if (p0.length == 0 && p1.length == 0) return " ";
        if (p0.length < 6 && p0.length != 0) return translate("Too short, at least 6 characters.");
        if (p0 != p1) return translate("The confirmation is not identical.");
        handler.set_permanent_password(p0);
        nemoRefreshPwUi();
    }, msgbox_default_height, get_msgbox_width());
    self.timer(30ms, function() { updateSetPasswordSubmitState(); });
}

function nemoToggle2fa() {
    if (handler.has_valid_2fa()) {
        handler.set_option('2fa', '');
        nemoRefreshPwUi();
        return;
    }
    var new2fa = handler.generate2fa();
    var src = handler.generate_2fa_img_src(new2fa);
    msgbox("custom-2fa-setting", translate('enable-2fa-title'),
        <div .form>
            <div>{translate('enable-2fa-desc')}</div>
            <img src={src} />
            <div .code><input name='code' type='text' .outline-focus /></div>
        </div>
        , "", function(res=null) {
        if (!res) return;
        if (!res.code) return;
        if (!handler.verify2fa(res.code)) return translate('wrong-2fa-code');
        nemoRefreshPwUi();
    }, 400, get_msgbox_width());
}

// Entry point used by both the main-window "..." button (MyIdMenu) and the
// outgoing-only #open-settings link.
function nemoOpenSettingsDialog() {
    if (!nemoSettingsDialog) return;
    nemoSettingsDialog.open();
}

class NemoSettingsDialog: Reactor.Component {
    function this() {
        nemoSettingsDialog = this;
    }

    function open(v = true) {
        // Populate the sub-menu sources so Audio/Enhancements/Language can pop
        // (AudioInputs only renders its <menu> once show=true).
        if (audioInputMenu) audioInputMenu.update({ show: true });
        if (direct_server) direct_server.update();
        this.update({ shown: true });
    }

    function close(v = false) {
        this.update({ shown: false });
    }

    // ---- pure vnode builders (safe to call from render) ---------------------
    function tRow(id, label, on, fixed, kind, extra = null) {
        var cls = "nemo-set-row nemo-set-toggle " + (on ? "on" : "off");
        if (fixed) cls += " fixed";
        return <div class={cls} data-toggle={id} data-kind={kind} data-fixed={fixed ? "1" : "0"}>
            <span .nemo-set-box>{on ? svg_checkmark : ""}</span>
            <span .nemo-set-label>{label}</span>
            {extra ? extra : ""}
        </div>;
    }

    function aRow(action, label) {
        return <div class="nemo-set-row nemo-set-action" data-action={action}>
            <span .nemo-set-label>{label}</span>
            <span .nemo-set-arrow>{">"}</span>
        </div>;
    }

    function pEnable(arr, id, label) {
        arr.push(this.tRow(id, label, handler.get_option(id) != "N", handler.is_option_fixed(id), "enable"));
    }
    function pAllow(arr, id, label) {
        arr.push(this.tRow(id, label, handler.get_option(id) == "Y", handler.is_option_fixed(id), "allow"));
    }

    function section(title, rows) {
        if (!rows.length) return "";
        return <div .nemo-set-section>
            <div .nemo-set-section-title>{title}</div>
            <div .nemo-set-rows>{rows}</div>
        </div>;
    }

    function render() {
        if (!this.shown) return <div .nemo-settings-hidden />;

        // ---- Permissions ---------------------------------------------------
        var perm = [];
        if (!disable_settings) {
            this.pEnable(perm, "enable-keyboard", translate('Enable keyboard/mouse'));
            this.pEnable(perm, "enable-clipboard", translate('Enable clipboard'));
            this.pEnable(perm, "enable-file-transfer", translate('Enable file transfer'));
            this.pEnable(perm, "enable-camera", translate('Enable camera'));
            this.pEnable(perm, "enable-terminal", translate('Enable terminal'));
            this.pEnable(perm, "enable-remote-restart", translate('Enable remote restart'));
            this.pEnable(perm, "enable-tunnel", translate('Enable TCP tunneling'));
            if (is_win) this.pEnable(perm, "enable-block-input", translate('Enable blocking user input'));
            if (handler.get_supported_privacy_mode_impls() != '[]') this.pEnable(perm, "enable-privacy-mode", translate('Enable privacy mode'));
            this.pEnable(perm, "enable-lan-discovery", translate('Enable LAN discovery'));
            this.pAllow(perm, "allow-remote-config-modification", translate('Enable remote configuration modification'));
        }

        // ---- Security & Network -------------------------------------------
        var sec = [];
        if (!disable_settings) {
            if (!hide_server_settings) sec.push(this.aRow("custom-server", translate('ID/Relay Server') + ((nemoExeServerSettingsLocked() || nemoManagementServerSettingsLocked()) ? " (locked)" : "")));
            if (!hide_server_settings && nemo_management_settings) sec.push(this.aRow("nemo-management", "Management"));
            if (nemo_management_settings) sec.push(this.aRow("nemo-alias", translate('Alias')));
            sec.push(this.aRow("import-device-key", translate('Import device key')));
            sec.push(this.aRow("whitelist", translate('IP Whitelisting')));
            if (!hide_proxy_settings) sec.push(this.aRow("socks5-server", translate('Socks5/Http(s) Proxy')));
            if (!hide_websocket_settings) this.pAllow(sec, "allow-websocket", translate('Use WebSocket'));
            if (!using_public_server && !outgoing_only) sec.push(this.tRow("disable-udp", translate('Disable UDP'), handler.get_option("disable-udp") == "Y", handler.is_option_fixed("disable-udp"), "udp"));
            if (!using_public_server) this.pAllow(sec, "allow-insecure-tls-fallback", translate('Allow insecure TLS fallback'));
        }

        // ---- General -------------------------------------------------------
        var gen = [];
        if (!hide_stop_service || service_stopped) {
            var svc_stopped = handler.get_option("stop-service") == "Y";
            gen.push(this.tRow("stop-service", translate('Enable service'), !svc_stopped, handler.is_option_fixed("stop-service"), "service"));
        }
        if (!disable_settings) {
            var direct_on = handler.get_option("direct-server") == "Y";
            gen.push(this.tRow("direct-server", translate('Enable direct IP access'), direct_on, handler.is_option_fixed("direct-server"), "direct"));
            if (direct_on) gen.push(this.aRow("edit-direct-port", translate('Port')));
            if (is_win && handler.is_installed()) gen.push(this.tRow("share-rdp", translate('Enable RDP session sharing'), handler.is_share_rdp(), false, "rdp"));
        }
        gen.push(this.tRow("allow-darktheme", translate('Dark Theme'), handler.get_option("allow-darktheme") == "Y", handler.is_option_fixed("allow-darktheme"), "theme"));
        if (!disable_installation) this.pAllow(gen, "allow-auto-update", translate('Auto update'));
        gen.push(this.aRow("audio", translate('Audio Input')));
        gen.push(this.aRow("enhancements", translate('Enhancements')));
        gen.push(this.aRow("language", translate('Language')));
        gen.push(this.aRow("about", translate('About') + " TBFDesk"));
        if (!disable_change_id && !disable_settings && handler.is_ok_change_id() && key_confirmed && connect_status > 0) gen.push(this.aRow("change-id", translate('Change ID')));

        // ---- Password (moved here from the one-time-password "edit" menu) ---
        var pw = [];
        if (!disable_settings) {
            var approve_mode = handler.get_option('approve-mode');
            var show_password = approve_mode != 'click';
            var vm = handler.get_option('verification-method');
            if (vm != 'use-temporary-password' && vm != 'use-permanent-password') vm = 'use-both-passwords';
            var amode_fixed = handler.is_option_fixed('approve-mode');
            var vm_fixed = handler.is_option_fixed('verification-method');
            pw.push(this.tRow("approve-mode-password", translate('Accept sessions via password'), approve_mode == 'password', amode_fixed, "amode"));
            pw.push(this.tRow("approve-mode-click", translate('Accept sessions via click'), approve_mode == 'click', amode_fixed, "amode"));
            pw.push(this.tRow("approve-mode-both", translate('Accept sessions via both'), approve_mode != 'password' && approve_mode != 'click', amode_fixed, "amode"));
            if (show_password) {
                pw.push(this.tRow("use-temporary-password", translate('Use one-time password'), vm == 'use-temporary-password', vm_fixed, "vmethod"));
                pw.push(this.tRow("use-permanent-password", translate('Use permanent password'), vm == 'use-permanent-password', vm_fixed, "vmethod"));
                pw.push(this.tRow("use-both-passwords", translate('Use both passwords'), vm == 'use-both-passwords', vm_fixed, "vmethod"));
                if (!disable_change_permanent_password) {
                    pw.push(this.aRow("set-permanent-password", translate('Set permanent password')));
                    if (handler.is_local_permanent_password_set()) pw.push(this.aRow("clear-permanent-password", translate('Clear permanent password')));
                }
                var tpl = handler.get_option('temporary-password-length');
                if (!tpl) tpl = "6";
                var tpl_fixed = handler.is_option_fixed('temporary-password-length');
                pw.push(this.tRow("tpl-6", translate('One-time Password') + " (6)", tpl == "6", tpl_fixed, "tpl"));
                pw.push(this.tRow("tpl-8", translate('One-time Password') + " (8)", tpl == "8", tpl_fixed, "tpl"));
                pw.push(this.tRow("tpl-10", translate('One-time Password') + " (10)", tpl == "10", tpl_fixed, "tpl"));
            }
            pw.push(this.tRow("tfa", translate('enable-2fa-title'), handler.has_valid_2fa(), false, "tfa"));
        }

        // Account (Login/Logout) intentionally NOT here — it lives in the
        // account bar at the top of the left pane.

        // Order sections by entry count (most first), so the biggest subsection
        // leads and a person sees all of its entries at a glance.
        var sections = [
            { title: translate('Permissions'), rows: perm },
            { title: translate('Security') + " & " + translate('Network'), rows: sec },
            { title: translate('General'), rows: gen },
            { title: translate('Password'), rows: pw },
        ];
        sections.sort(function(a, b) { return b.rows.length - a.rows.length; });
        var sectionNodes = [];
        for (var s in sections) sectionNodes.push(this.section(s.title, s.rows));

        return <div .nemo-settings-overlay>
            <div .nemo-settings-panel>
                <div .nemo-settings-head>
                    <div .nemo-settings-title>{translate('Settings')}</div>
                    <div .nemo-settings-close #nemo-settings-close><svg style="size:13px" viewBox="0 0 100 100"><path fill="#888" d="M20 12 L50 42 L80 12 L88 20 L58 50 L88 80 L80 88 L50 58 L20 88 L12 80 L42 50 L12 20 Z"/></svg></div>
                </div>
                <div .nemo-settings-body>
                    {sectionNodes}
                </div>
            </div>
        </div>;
    }

    event click $(#nemo-settings-close) {
        this.close();
    }

    // Click on the dimmed backdrop (but not the panel) closes the dialog.
    event click $(div.nemo-settings-overlay) (evt, me) {
        if (evt.target === me) this.close();
    }

    event click $(div.nemo-set-toggle) (evt, me) {
        if (me.attributes["data-fixed"] == "1") return;
        var id = me.attributes["data-toggle"];
        var kind = me.attributes["data-kind"];
        if (kind == "enable") {
            handler.set_option(id, handler.get_option(id) == "N" ? default_option_yes : "N");
        } else if (kind == "allow") {
            handler.set_option(id, handler.get_option(id) == "Y" ? default_option_no : "Y");
        } else if (kind == "udp") {
            handler.set_option("disable-udp", handler.get_option("disable-udp") == "Y" ? "N" : "Y");
        } else if (kind == "service") {
            handler.set_option("stop-service", service_stopped ? default_option_no : "Y");
            service_stopped = handler.get_option("stop-service") == "Y";
            if (app) app.update();
        } else if (kind == "theme") {
            handler.set_option("allow-darktheme", handler.get_option("allow-darktheme") == "Y" ? default_option_no : "Y");
            updateTheme();
        } else if (kind == "rdp") {
            handler.set_share_rdp(!handler.is_share_rdp());
        } else if (kind == "direct") {
            handler.set_option("direct-server", handler.get_option("direct-server") == "Y" ? default_option_no : "Y");
        } else if (kind == "vmethod") {
            handler.set_option('verification-method', id);
            if (passwordArea) passwordArea.update();
        } else if (kind == "amode") {
            var am = id == "approve-mode-password" ? "password" : (id == "approve-mode-click" ? "click" : default_option_approve_mode);
            handler.set_option('approve-mode', am);
            if (passwordArea) passwordArea.update();
        } else if (kind == "tpl") {
            handler.set_option('temporary-password-length', id.substring(4));
            if (passwordArea) passwordArea.update();
        } else if (kind == "tfa") {
            nemoToggle2fa();
        }
        this.update();
    }

    event click $(div.nemo-set-action) (evt, me) {
        var act = me.attributes["data-action"];
        if (act == "custom-server") open_custom_server_dialog();
        else if (act == "nemo-management") open_nemo_management_dialog();
        else if (act == "nemo-alias") open_nemo_alias_dialog();
        else if (act == "import-device-key") open_import_device_key_dialog();
        else if (act == "whitelist") open_whitelist_dialog();
        else if (act == "socks5-server") open_proxy_dialog();
        else if (act == "edit-direct-port") editDirectAccessPort();
        else if (act == "about") { if (myIdMenu) myIdMenu.showAbout(); }
        else if (act == "change-id") nemoChangeIdDialog();
        else if (act == "login") { this.close(); login(); }
        else if (act == "logout") { this.close(); logout(); }
        else if (act == "audio") this.popupSub("menu#audio-input", me);
        else if (act == "enhancements") this.popupSub("menu#enhancements-menu", me);
        else if (act == "language") this.popupSub("menu#languages", me);
        else if (act == "set-permanent-password") nemoSetPasswordDialog();
        else if (act == "clear-permanent-password") { handler.set_permanent_password(""); nemoRefreshPwUi(); this.update(); }
    }

    // Pop one of the original sub-menus (kept alive inside MyIdMenu's popup) as a
    // fly-out anchored to the clicked row.
    function popupSub(sel, anchorEl) {
        var m = myIdMenu ? myIdMenu.$(sel) : null;
        if (!m) m = $(sel);
        if (m) anchorEl.popup(m);
    }
}

class App: Reactor.Component
{
    function this() {
        app = this;
    }

    function render() {
        // Login-first gate: when the server requires login and nobody is signed
        // in, hide the entire UI (ID, connect field, address book) and show only
        // a login screen. render() must stay pure — the login modal is opened by
        // nemoEnforceLogin (view context), not here.
        if (nemoLoginRequired() && !nemoIsLoggedIn()) {
            return
                <div style="background:#f0f2f5; size:*">
                    <div style="margin:*; width:340px; padding:40px 42px; background:#fff; border:1px solid #e2e6ea; border-radius:10px; flow:vertical">
                        <div style="text-align:center; font-size:30px; font-weight:bold; color:#0b7285; margin-bottom:6px">TBFDesk</div>
                        <div style="text-align:center; color:#667; margin-bottom:26px; font-size:14px">{translate('Please sign in to continue')}</div>
                        <div style="font-size:12px; color:#556; margin-bottom:5px">{translate('Server')} <span style="color:#9aa7b2">({translate('address of your TBFDesk server')})</span></div>
                        <input|text .gate-input #gate-server value={nemoGateServerValue()} placeholder="tbfdesk.example.com" style="width:*; padding:9px 10px; margin-bottom:8px; border:1px solid #ccd2d8; border-radius:6px; font-size:14px" />
                        {nemoInsecureTlsManaged()
                            ? <div style="font-size:11px; color:#8a94a0; margin-bottom:16px">{nemoInsecureTlsValue() ? translate('Insecure TLS is currently allowed') : translate('Insecure TLS is currently blocked')} ({translate('managed by your administrator')})</div>
                            : <button|checkbox(gate_insecure) #gate-insecure-tls {nemoInsecureTlsAttrs()} style="margin-bottom:16px; font-size:12px; color:#667">{translate('Allow insecure TLS (self-signed certificate)')}</button>}
                        <div style="font-size:12px; color:#556; margin-bottom:5px">{translate('Username')} <span style="color:#9aa7b2">({translate('use your Windows credentials')})</span></div>
                        <input|text .gate-input #gate-username style="width:*; padding:9px 10px; margin-bottom:16px; border:1px solid #ccd2d8; border-radius:6px; font-size:14px" />
                        <div style="font-size:12px; color:#556; margin-bottom:5px">{translate('Password')}</div>
                        <div .gate-passwrap #gate-pass-wrap style="margin-bottom:24px"><PasswordComponent name='gatepass' /></div>
                        <div style="text-align:center">
                            <button .button #gate-login style="padding:11px 44px; background:#0b7285; color:#fff; border:none; border-radius:6px; font-size:15px; font-weight:bold">{translate('Login')}</button>
                        </div>
                        <div #gate-error style="color:#d4380d; font-size:12px; margin-top:16px; text-align:center"></div>
                        {nemoCertBoxVnode()}
                        <div .link #gate-import-devkey style="text-align:center; margin-top:14px; font-size:12px; color:#0b7285; text-decoration:underline; cursor:pointer">{translate('Import device key')}</div>
                    </div>
                </div>;
        }
        var is_can_screen_recording = handler.is_can_screen_recording(false);
        return
            <div .app>
                    <div .left-pane style={incoming_only ? "width:*" : ""}>
                    <div>
                        {!outgoing_only && nemoIsLoggedIn() && <div .nemo-account-bar>
                            <span .link #open-settings title={translate('Settings')} style="position:absolute; right:4px; top:4px; transform:scale(0.72); transform-origin:right top; opacity:0.75">{svg_menu}</span>
                            <div .nemo-account-name>{nemoAccountName()}</div>
                            <div style="flow:horizontal">
                                <button .button .outline #nemo-logoff>{translate('Logout')}</button>
                            </div>
                        </div>}
                        {is_custom_client && handler.get_builtin_option("hide-powered-by-me") != "Y" ? <div .link #powered-by style="opacity:0.5;font-size:0.8em;text-decoration:underline">{translate('powered_by_me')}</div> : ""}
                        <div .title style="flow:horizontal; position:relative; height:1.6em; line-height:1.6em">
                            <span>{translate('Your Desktop')}</span>
                            {(outgoing_only || !nemoIsLoggedIn()) ? <span .link #open-settings title={translate('Settings')} style="position:absolute; right:0; bottom:-2px; transform:scale(0.8); transform-origin:right bottom; opacity:0.8">{svg_menu}</span> : ""}
                        </div>
                        <div .lighter-text>{outgoing_only ? translate('outgoing_only_desk_tip') : translate('desk_tip')}</div>
                        {outgoing_only ? <div style="position:absolute; left:-10000px; top:-10000px; width:0; height:0; overflow:hidden"><MyIdMenu /></div> : ""}
                        {!outgoing_only && <div .your-desktop>
                            <MyIdMenu />
                            {key_confirmed ? <input type="text" readonly value={formatId(get_id())}/> : translate("Generating ...")}
                        </div>}
                        {!outgoing_only && <PasswordArea />}
                    </div>
                    {"" /* TBFDesk: UAC install nag removed */}
                    {"" /* TBFDesk: upstream update banner removed */}
                    {is_win && handler.is_installed() && !software_update_url && handler.is_installed_lower_version() && !disable_installation ? <UpgradeMe /> : ""}
                    {is_can_screen_recording ? "": <CanScreenRecording />}
                    {is_can_screen_recording && !handler.is_process_trusted(false) ? <TrustMe /> : ""}
                    {!service_stopped && is_can_screen_recording && handler.is_process_trusted(false) && handler.is_installed() && !handler.is_installed_daemon(false) ? <InstallDaemon /> : ""}
                    {system_error ? <SystemError /> : ""}
                    {!system_error && handler.is_login_wayland() && !handler.current_is_wayland() ? <FixWayland /> : ""}
                    {!system_error && handler.current_is_wayland() ? <ModifyDefaultLogin /> : ""}
                    {incoming_only ? <ConnectStatus @{this.connect_status} /> : ""}
                    {!outgoing_only && nemoIsLoggedIn() && <div .nemo-refresh-bottom>
                        <button .button .outline #nemo-refresh-ab title={translate('Reload address book from server')}>{translate('Refresh')}</button>
                    </div>}
                </div>
                {!incoming_only && <div .right-pane>
                    <div .right-content>
                        <div .card-connect>
                            <div .title>{translate('Control Remote Desktop')}</div>
                            <ID @{this.remote_id} />
                            <div .right-buttons>
                                <button .button .outline #file-transfer disabled={nemoOutboundEnabled() ? "false" : "true"}>{translate('Transfer file')}</button>
                                <button .button #connect disabled={nemoOutboundEnabled() ? "false" : "true"}>{translate('Connect')}</button>
                            </div>
                        </div>
                        <MultipleSessions @{this.multipleSessions} />
                    </div>
                    {!outgoing_only ? <ConnectStatus @{this.connect_status} /> : ""}
                </div>}
                <div #overlay style="position: absolute;size:*;background:black;opacity:0.5;display:none" />
                <NemoSettingsDialog />
            </div>;
    }

    event click $(button#connect) {
        this.newRemote("connect");
    }

    event click $(button#file-transfer) {
        this.newRemote("file-transfer");
    }

    event click $(button#gate-login) {
        nemoGateSubmit();
    }

    event click $(button#gate-insecure-tls) {
        nemoToggleInsecureTls();
    }

    event click $(#gate-cert-download) {
        nemoDownloadCert();
    }

    event click $(#gate-import-devkey) {
        open_import_device_key_dialog();
    }

    event keydown $(input.gate-input) (evt) {
        if (isEnterKey(evt)) nemoGateSubmit();
    }

    event keydown $(#gate-pass-wrap input) (evt) {
        if (isEnterKey(evt)) nemoGateSubmit();
    }

    function newRemote(type) {
        createNewConnect(this.remote_id.value, type);
    }
}

class InstallMe: Reactor.Component {
    function render() {
        return <div .install-me>
            <span />
            <div>{translate('install_tip')}</div>
            <div><button #install-me .button>{translate('Install')}</button></div>
        </div>;
    }

    event click $(#install-me) {
        handler.goto_install();
    }
}

function download(from, to, args..) {
    var rqp = { type:#get, url: from, toFile: to };
    var fn = 0;
    var on = 0;
    for( var p in args ) {
        if( p instanceof Function ) {
            switch(++fn) {
                case 1: rqp.success = p; break;
                case 2: rqp.error = p; break;
                case 3: rqp.progress = p; break;
            }
        } else if( p instanceof Object ) {
            switch(++on) {
                case 1: rqp.params = p; break;
                case 2: rqp.headers = p; break;
            }
        }  
    }
    view.request(rqp);
}

// current running version is higher than installed
class UpgradeMe: Reactor.Component {
    function render() {
        var update_or_download = is_osx ? "download" : "update";
        return <div .install-me>
            <div>{translate('Status')}</div>
            <div>{translate('Your installation is lower version.')}</div>
            <div #install-me.link>{translate('Click to upgrade')}</div>
        </div>;
    }

    event click $(#install-me) {
        handler.update_me("");
    }
}

class UpdateMe: Reactor.Component {
    function render() {
        var update_or_download = "download"; // !is_win ? "download" : "update";
        return <div .install-me>
            <div>{translate('Status')}</div>
            <div>There is a newer version of TBFDesk ({handler.get_new_version()}) available.</div>
            {is_custom_client
                ? <div style="font-size: 1em; font-weight: normal; text-align: left; padding-top: 1em;">{translate('Enable \"Auto update\" or contact your administrator for the latest version.')}</div>
                : <div #install-me.link>{translate('Click to ' + update_or_download)}</div>}
            <div #download-percent style="display:hidden; padding-top: 1em;" />
        </div>;
    }

    event click $(#install-me) {
        handler.open_url("https://rustdesk.com/download");
        return;
        if (!is_win) {
            handler.open_url("https://rustdesk.com");
            return;
        }
        var url = software_update_url + '.' + handler.get_software_ext();
        var path = handler.get_software_store_path();
        var onsuccess = function(md5) {
            $(#download-percent).content(translate("Installing ..."));
            handler.update_me(path);
        };
        var onerror = function(err) {
            msgbox("custom-error", "Download Error", "Failed to download"); 
        };
        var onprogress = function(loaded, total) {
            if (!total) total = 5 * 1024 * 1024;
            var el = $(#download-percent);
            el.style.set{display: "block"};
            el.content("Downloading %" + (loaded * 100 / total));
        };
        stdout.println("Downloading " + url + " to " + path);
        download(
            url,
            self.url(path),
            onsuccess, onerror, onprogress);
    }
}

class SystemError: Reactor.Component {
    function render() {
        return <div .install-me>
            <div>{system_error}</div>
        </div>;
    }
}


}

function self.closing() {
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    handler.closing(x, y, w, h);
    return true;
}

function nemoMax(a, b) {
    return a > b ? a : b;
}

function nemoMeasuredHeight(el) {
    if (!el) return 0;
    return nemoMax(el.box(#height, #border), el.box(#height, #content));
}

function nemoInitialWindowFitSize() {
    var minw = scaleIt(incoming_only ? incoming_only_width : 800);
    var minh = scaleIt(incoming_only ? 390 : 600);
    var h = minh;

    h = nemoMax(h, nemoMeasuredHeight($(body)));
    h = nemoMax(h, nemoMeasuredHeight($(div.app)));
    h = nemoMax(h, nemoMeasuredHeight($(div.left-pane)));
    h = nemoMax(h, nemoMeasuredHeight($(div.right-pane)));
    h = nemoMax(h, nemoMeasuredHeight($(div.right-content)));

    return [minw, h + scaleIt(nemo_initial_window_fit_padding)];
}

function nemoFitInitialWindowToContent() {
    if (!nemo_fit_initial_window_to_content || !is_win) return;
    if (view.windowState == View.WINDOW_MAXIMIZED ||
        view.windowState == View.WINDOW_FULL_SCREEN) return;

    var fit = nemoInitialWindowFitSize();
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    var targetw = nemoMax(w, fit[0]);
    var targeth = nemoMax(h, fit[1]);
    if (targetw == w && targeth == h) return;

    var (sx, sy, sw, sh) = view.screenBox(#workarea, #rectw);
    if (targetw > sw) targetw = sw;
    if (targeth > sh) targeth = sh;
    if (x + targetw > sx + sw) x = sx + sw - targetw;
    if (y + targeth > sy + sh) y = sy + sh - targeth;
    if (x < sx) x = sx;
    if (y < sy) y = sy;

    view.move(x.toInteger(), y.toInteger(), targetw.toInteger(), targeth.toInteger());
}

function nemoScheduleInitialWindowAutofit() {
    if (!nemo_fit_initial_window_to_content || !is_win) return;
    self.timer(1ms, nemoFitInitialWindowToContent);
    self.timer(250ms, nemoFitInitialWindowToContent);
    self.timer(1000ms, nemoFitInitialWindowToContent);
}

function self.ready() {
    var r = handler.get_size();
    if (isReasonableSize(r) && r[2] > 0) {
        var (sx, sy, sw, sh) = view.screenBox(#workarea, #rectw);
        if (r[2] >= sw && r[3] >= sh) {
            self.timer(1ms, function() { view.windowState = View.WINDOW_MAXIMIZED; });
        } else {
            view.move(r[0], r[1], incoming_only ? scaleIt(incoming_only_width) : r[2], r[3]);
        }
    } else {
        centerize(scaleIt(incoming_only ? incoming_only_width : 800), scaleIt(incoming_only ? 390 : 600));
    }
    if (!handler.get_remote_id()) {
        view.focus = $(#remote_id);
    }
    nemoScheduleInitialWindowAutofit();
    refreshCurrentUser();
    updateTheme();
    // Login-first: start the perpetual login-gate watcher shortly after startup.
    self.timer(400ms, nemoEnforceLogin);
}

function showAbout() {
    myIdMenu.showAbout();
}

function showSettings() {
    // TBFDesk: outgoing-only #open-settings now opens the modal Settings dialog.
    nemoOpenSettingsDialog();
}

function checkConnectStatus() {
    handler.check_mouse_time(); // trigger connection status updater
    self.timer(1s, function() {
        var tmp = handler.get_option("stop-service") == "Y";
        if (tmp != service_stopped) {
            service_stopped = tmp;
            app.update();
        }
        tmp = handler.using_public_server();
        if (tmp != using_public_server) {
            using_public_server = tmp;
            // Guard: while the login gate is showing, App.render omits ConnectStatus
            // and MyIdMenu, so these component refs are undefined. Calling .update()
            // on undefined would throw and abort this callback BEFORE it re-arms the
            // 1s timer below (line ~checkConnectStatus()), silently killing all live
            // status polling even after login.
            if (app.connect_status) app.connect_status.update();
        }
        tmp = handler.get_connect_status();
        if (tmp[0] != connect_status) {
            connect_status = tmp[0];
            if (app.connect_status) app.connect_status.update();
            if (myIdMenu) myIdMenu.update();
        }
        if (tmp[1] != key_confirmed) {
            key_confirmed = tmp[1];
            app.update();
        }
        if (tmp[2] && tmp[2] != my_id) {
            stdout.println("id updated");
            app.update();
        }
        tmp = handler.get_error();
        if (system_error != tmp) {
            system_error = tmp;
            app.update();
        }
        tmp = handler.get_software_update_url();
        if (tmp != software_update_url) {
            software_update_url = tmp;
            app.update();
        }
        if (handler.recent_sessions_updated()) {
            stdout.println("recent sessions updated");
            updateAbPeer();
            app.update();
        }
        tmp = handler.get_option("disable-udp") == "Y";
        if (tmp != disable_udp) {
            disable_udp = tmp;
            app.update();
        }
        check_if_overlay();
        checkConnectStatus();    
    });                          
}                                
                                 
var enter = false;               
function self.onMouse(evt) {     
    switch(evt.type) {           
    case Event.MOUSE_ENTER:    
        enter = true;
        check_if_overlay();
        break;
    case Event.MOUSE_LEAVE:
        if ($(#overlay)) $(#overlay).style#display = 'none'; // login gate has no #overlay
        enter = false;
        break;
    }
}

function check_if_overlay() {
    var enabled;
    var is_enabled_by_control_permissions = handler.is_remote_modify_enabled_by_control_permissions();
    if (is_enabled_by_control_permissions == "true") {
        enabled = true;
    } else if (is_enabled_by_control_permissions == "false") {
        enabled = false;
    } else {
        enabled = handler.get_option('allow-remote-config-modification') == 'Y';
    }
    if (!enabled) {
        var time0 = getTime();
        handler.check_mouse_time();
        self.timer(120ms, function() {
            if (!enter) return;
            var d = time0 - handler.get_mouse_time();
            if ($(#overlay) && d < 120) $(#overlay).style#display = 'block';
        });
    }
}

checkConnectStatus();

function set_local_user_info(user) {
    var user_info = {name: user.name};
    if (user.display_name) {
        user_info.display_name = user.display_name;
    }
    if (user.avatar) {
        user_info.avatar = user.avatar;
    }
    if (user.status) {
        user_info.status = user.status;
    }
    handler.set_local_option("user_info", JSON.stringify(user_info));
}

// Login-first gate watcher: keeps the App showing the sign-in screen (its own
// "Login" button) whenever the server requires login and nobody is signed in, and
// reveals the normal UI once signed in. Runs perpetually (cheap) because the state
// changes asynchronously in BOTH directions — the require-login flag arrives with
// the (async) policy poll, and a session can be invalidated by the poll's
// stale-session self-heal. It only re-renders on a real transition. It does NOT
// auto-open the login modal: the gate is shown so the user can read it and click
// Login themselves (auto-opening it hid the gate and made Cancel a close/reopen loop).
function nemoEnforceLogin() {
    var gate = nemoLoginRequired() && !nemoIsLoggedIn();
    if (gate !== nemoLastGate) {                 // shown<->hidden transition only
        nemoLastGate = gate;
        if (gate) nemoInitInsecureTlsDefault();   // seed accept-self-signed before render
        if (app) app.update();
        // Focus the username field and inspect the server cert once shown.
        if (gate) self.timer(60ms, function() {
            var u = $(#gate-username); if (u) view.focus = u;
            nemoRefreshCertInfo();
        });
    }
    // #3-push: the server bumps nemo-ab-version (delivered in the signed policy
    // poll) whenever an ACL change affects what a user may see. Re-fetch the
    // address book when it changes, so edits appear without a manual refresh.
    if (nemoIsLoggedIn()) {
        var abv = (handler.get_option("nemo-ab-version") || "").trim();
        if (abv && abv != nemoLastAbVersion) {
            if (nemoLastAbVersion !== null) getAb();   // skip the first observation
            nemoLastAbVersion = abv;
        }
    }
    self.timer(3s, nemoEnforceLogin);
}

// Inline sign-in for the login-first gate: the username/password fields are
// rendered directly on the gate (no separate modal). Mirrors login()'s /api/login
// flow but reads the gate inputs and reports errors inline in #gate-error.
function nemoGateSubmit() {
    var uEl = $(#gate-username), errEl = $(#gate-error);
    var pwrap = $(#gate-pass-wrap);
    var pEl = pwrap ? pwrap.$(input) : null;   // PasswordComponent's inner input
    var name = (uEl ? (uEl.value || '') : '').trim();
    var pass = (pEl ? (pEl.value || '') : '').trim();
    var setErr = function(t) { if (errEl) errEl.text = t; };
    if (!name) { setErr(translate("Username missed")); if (uEl) view.focus = uEl; return; }
    if (!pass) { setErr(translate("Password missed")); if (pEl) view.focus = pEl; return; }
    // Apply + save the server address from the gate field before logging in.
    var srvEl = $(#gate-server);
    if (srvEl) nemoApplyGateServer(srvEl.value);
    var url = handler.get_api_server();
    if (!url) { setErr(translate("API Server") + " ?"); if (srvEl) view.focus = srvEl; return; }
    setErr("");
    abLoading = true;
    var onSuccess = function(data) {
        if (data.error) { abLoading = false; setErr(translate(data.error)); return; }
        if (data.type == 'email_check') { abLoading = false; setErr(""); on_2fa_check(data); return; }
        handler.set_local_option("access_token", data.access_token);
        set_local_user_info(data.user);
        nemoGateShown = false;
        nemoLastGate = false;
        if (app) app.update();               // reveal the app
        if (myIdMenu) myIdMenu.update();
        getAb();                             // load the address book
    };
    var onError = function(err, status) {
        abLoading = false;
        err = translate(err);
        if (url.indexOf('rustdesk') < 0) err = url + ', ' + err;
        setErr(err);
    };
    var loginPlain = function() {
        httpRequest(url + "/api/login", #post,
            {username: name, password: pass, id: my_id, uuid: handler.get_uuid(), type: 'account', deviceInfo: getDeviceInfo()},
            onSuccess, onError);
    };
    var loginSealed = function(sealed) {
        httpRequest(url + "/api/login", #post,
            {sealed: sealed, id: my_id, uuid: handler.get_uuid(), type: 'account', deviceInfo: getDeviceInfo()},
            onSuccess, onError);
    };
    // S-B: seal the credential to the server's login-encryption key so the password
    // is confidential regardless of TLS. On a MANAGED client (management key set),
    // refuse to send plaintext if sealing fails; on an unmanaged/dev client, fall back.
    var managed = (handler.get_option("nemo-management-public-key") || "").trim() != "";
    httpRequest(url + "/api/login-key", #post, {},
        function(keyData) {
            var sealed = (keyData && keyData.signed_key) ? handler.nemo_seal_login(keyData.key || "", keyData.signed_key || "", name, pass) : "";
            if (sealed) { loginSealed(sealed); }
            else if (managed) { abLoading = false; setErr(translate("Secure login unavailable: the server key could not be verified.")); }
            else { loginPlain(); }
        },
        function(err, status) {
            if (managed) { onError(err, status); } else { loginPlain(); }
        });
}

function login(force = false) {
    var name0 = getUserName();
    var pass0 = '';
    msgbox("custom-login", translate('Login'), <div .form .set-password>
            <div><span>{translate('Username')}:</span><input|text name="username" value={name0} .outline-focus /></div>
            <div><span>{translate('Password')}:</span><PasswordComponent value={pass0} /></div>
        </div>, "", function(res=null, show_progress) {
        if (!res) {
            // Cancel just closes the modal. The login gate (logo + text + Login
            // button) stays visible underneath, so the user can retry by clicking
            // Login. Do NOT auto-re-prompt — that created a close/reopen deadloop.
            return;
        }
        show_progress();
        var name = (res.username || '').trim();
        if (!name) {
            show_progress(false, translate("Username missed"));
            return " ";
        }
        var pass = (res.password || '').trim();
        if (!pass) {
            show_progress(false, translate("Password missed"));
            return " ";
        }
        abLoading = true;
        var url = handler.get_api_server();
        httpRequest(url + "/api/login", #post, {username: name, password: pass, id: my_id, uuid: handler.get_uuid(), type: 'account', deviceInfo: getDeviceInfo()}, function(data) {
            if (data.error) {
                abLoading = false;
                var err = translate(data.error);
                show_progress(false, err);
                return;
            }
            if (data.type == 'email_check') {
                abLoading = false;
                show_progress(-1);
                on_2fa_check(data);
                return;
            }
            handler.set_local_option("access_token", data.access_token);
            set_local_user_info(data.user);
            // Reveal the app immediately: drop the login gate now instead of waiting
            // for the ~3s watcher tick, and load the address book BEFORE closing the
            // modal. Closing a login modal that the gate transition may have detached
            // can throw ("has no method show_progress"); doing it last (in try/catch)
            // means that error can no longer abort the address-book load — which was
            // why the address book came up empty right after logging in.
            nemoGateShown = false;
            nemoLastGate = false;
            if (app) app.update();
            if (myIdMenu) myIdMenu.update();
            getAb();
            try { show_progress(-1); } catch (e) {}
        }, function(err, status) {
            abLoading = false;
            err = translate(err);
            if (url.indexOf('rustdesk') < 0) err = url + ', ' + err;
            show_progress(false, err);
        });
        return " ";
      }, msgbox_default_height, get_msgbox_width());
}

function on_2fa_check(last_msg) {
    const isEmailCheck = !last_msg.tfa_type || last_msg.tfa_type == 'email_check';
    const secret = last_msg.secret;
    const emailHint = last_msg.user.email;

    msgbox("custom-2fa-verification-code", translate('Verification code'), <div .form .set-password> 
            { isEmailCheck && <div><span>{translate('Email')}:</span><span>{emailHint}</span></div> }
            <div><span>{translate(isEmailCheck ? 'Verification code' : '2FA code')}:</span><input|text name="verification_code" .outline-focus /></div> 
            { isEmailCheck && <div style="font-size:0.9em; margin-bottom:1em;">{translate('verification_tip')}</div> }
        </div>, "", 
        function(res=null, show_progress) {
            if (!res) return;
            show_progress();
            var code = (res.verification_code || '').trim();
            if (!code || code.length < 6) {
                show_progress(false, translate("Too short, at least 6 characters."));
                return " ";
            }
            abLoading = true;
            var url = handler.get_api_server();
            const loginData = {
                username: last_msg.user.name,
                id: my_id,
                uuid: handler.get_uuid(),
                type: 'email_code',
                verificationCode: code,
                tfaCode: isEmailCheck ? '' : code,
                secret: secret,
                deviceInfo: getDeviceInfo()
            };
            httpRequest(url + "/api/login", #post, loginData, 
                function(data) {
                    if (data.error) {
                        abLoading = false;
                        show_progress(false, data.error);
                        return;
                    }
                    handler.set_local_option("access_token", data.access_token);
                    set_local_user_info(data.user);
                    show_progress(-1);
                    myIdMenu.update();
                    getAb();
                },
                function(err, status) {
                    abLoading = false;
                    err = translate(err);
                    if (url.indexOf('rustdesk') < 0) err = url + ', ' + err;
                    show_progress(false, err);
                }
            );
            return " ";
        },
        msgbox_default_height,
        get_msgbox_width()
    );
}

function reset_token() {
    handler.set_local_option("access_token", "");
    handler.set_local_option("user_info", "");
    handler.set_local_option("selected-tags", "");
    myIdMenu.update();
    resetAb();
    if (abComponent) {
        abComponent.update();
    }
}

function logout() {
    var url = handler.get_api_server();
    httpRequest(url + "/api/logout", #post, {id: my_id, uuid: handler.get_uuid()}, function(data) {
    }, function(err, status) {
        msgbox("custom-error", translate('Error'), err);
    }, getHttpHeaders());
    reset_token();
}

// TBFDesk: explicit sign-out from the visible "Log off" button on the main
// screen (App.render's .nemo-logoff-bar). logout() clears the token via
// reset_token(); force the login gate to reappear immediately instead of
// waiting for the ~3s nemoEnforceLogin poll. If login isn't required, the user
// simply lands on the logged-out UI (the address book shows its Login link).
function nemoLogout() {
    logout();
    nemoGateShown = false;
    nemoLastGate = null;      // make nemoEnforceLogin treat the next state as a transition
    if (app) app.update();    // token already cleared → App.render shows the gate now
}

event click $(button#nemo-logoff) {
    nemoLogout();
}

// Manual address-book refresh: re-fetch the server-curated peer list so ACL
// changes (added/removed targets) show without waiting for a re-login.
event click $(button#nemo-refresh-ab) {
    getAb();
}

function refreshCurrentUser() {
    var token = handler.get_local_option("access_token");
    if (!token) { return; }
    abLoading = true;
    abError = "";
    app.update();
    httpRequest(handler.get_api_server() + "/api/currentUser", #post, {id: my_id, uuid: handler.get_uuid()}, function(data) {
        if (data.error) {
            if (data.error == 'Invalid token') {
              reset_token();
            }
            handleAbError(data.error);
            return;
        }
	if (!handler.verify_login(data.verifier, token)) {
          handleAbError("Please update your self-hosting server Pro to latest version");
          return;
        }
        set_local_user_info(data);
        myIdMenu.update();
        getAb();
    }, function(err, status) {
        if (status == 401 || status == 400) {
            reset_token();
        }
        handleAbError(err);
    }, getHttpHeaders());
} 

function getHttpHeaders() {
    return "Authorization: Bearer " + handler.get_local_option("access_token");
}

function getDeviceInfo() {
    return JSON.parse(handler.get_login_device_info());
}

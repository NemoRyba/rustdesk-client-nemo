var cursor_img = $(img#cursor);
is_file_transfer = handler.is_file_transfer();
var is_port_forward = handler.is_port_forward();
var input_blocked = false;
var display_width = 0;
var display_height = 0;
var display_remote_scale = 1;
var display_origin_x = 0;
var display_origin_y = 0;
var display_cursor_embedded = false;
var display_scale = 1;
// the scale factor is different from `display_scale` if peer platform is Linux (Wayland).
var cursor_scale = 1;
var keyboard_enabled = true; // server side
var clipboard_enabled = true; // server side
var audio_enabled = true; // server side
var file_enabled = true; // server side
var restart_enabled = true; // server side
var recording_enabled = true; // server side
var privacy_mode_enabled = true; // server side
var scroll_body = $(body);
var peer_platform = "";

handler.setDisplay = function(x, y, w, h, cursor_embedded, scale) {
    display_width = w;
    display_height = h;
    display_origin_x = x;
    display_origin_y = y;
    display_cursor_embedded = cursor_embedded;
    display_remote_scale = scale;
    adaptDisplay();
    if (recording) handler.record_screen(true, 0, w, h);
}

// in case toolbar not shown correctly
view.windowMinSize = (scaleIt(500), scaleIt(300));

function get_peer_platform() {
    if (peer_platform == "") {
        peer_platform = handler.peer_platform();
    }
    return peer_platform;
}

function isRemoteLinux() {
    return get_peer_platform() == "Linux";
}

function adaptDisplay() {
    var w = display_width;
    var h = display_height;
    if (!w || !h) return;
    var style = handler.get_view_style();
    display_scale = 1.;
    cursor_scale = 1.;
    var (sx, sy, sw, sh) = view.screenBox(view.windowState == View.WINDOW_FULL_SCREEN ? #frame : #workarea, #rectw);
    if (sw >= w && sh > h) {
        var hh = $(header).box(#height, #border);
        var el = $(div#adjust-window);
        if (sh > h + hh && el) {
            el.style.set{ display: "block" };
            el = $(li#adjust-window);
            el.style.set{ display: "block" };
            el.onClick = function() {
                view.windowState == View.WINDOW_SHOWN;
                var (x, y) = view.box(#position, #border, #screen);
                // extra for border
                var extra = is_win ? 4 : 2;
                view.move(x, y, (w + extra).toInteger(), (h + hh + extra).toInteger());
            }
        }
    }
    if (style != "original") {
        var bw = $(body).box(#width, #border);
        var bh = $(body).box(#height, #border);
        if (view.windowState == View.WINDOW_FULL_SCREEN) {
            bw = sw;
            bh = sh;
        }
        if (bw > 0 && bh > 0) {
            var scale_x = bw.toFloat() / w;
            var scale_y = bh.toFloat() / h;
            var scale = scale_x < scale_y ? scale_x : scale_y;
            if ((scale > 1 && style == "stretch") ||
                (scale < 1 && style == "shrink")) {
                display_scale = scale;
                w = w * scale;
                h = h * scale;
            }
        }
    }
    if (isRemoteLinux()) {
        cursor_scale = display_scale * display_remote_scale;
    } else {
        cursor_scale = display_scale;
    }
    if (cursor_scale <= 0.0001) cursor_scale = 1.;
    refreshCursor();
    handler.style.set {
        width: w / scaleFactor + "px",
        height: h / scaleFactor + "px",
    };
}

// ============================================================================
// "View all displays" mode (additive, OFF by default).
// Shows every remote display tiled in one window using one native <video> tile
// per display. Toggled from the header button. When off, nothing below runs and
// the legacy single-surface path (above) is fully unchanged.
// ============================================================================
var view_all_mode = false;
var view_all_wrapper = null;
// Per-display layout used to map tile-local mouse coords back to remote coords.
// view_all_layout[i] = { x: <virtual origin x>, y: <virtual origin y>, fit: <device-px per remote-px> }
var view_all_layout = {};

// ============================================================================
// Display modes (the grouped buttons in the header, header.tis renderDisplayModes):
//   "single"   one remote display in this window -- the classic view
//   "all"      every remote display tiled in this window (the original view-all)
//   "span"     this window stretched across ALL local monitors, each remote display
//              fitted onto its own physical monitor
//   "windows"  one window per remote display, each full screen on its own monitor;
//              the extra windows are opened by remote.rs over this same connection
// "span" and "windows" both stream every display at once over one connection, exactly
// like "all"; they differ only in where the pictures are put.
// ============================================================================
var display_mode = "single";
var window_restore = null;   // { rect: [x,y,w,h], state } to return to after span/windows
var span_map = [];           // [{ disp, mon: {x,y,w,h} relative to the window }]
var span_first_width = 0;    // where the toolbar is centred while spanning (not on the seam)

function viewAllSupported() {
    // Gate on >1 display AND peer version >= 1.2.4 (multi-UI-session support).
    return (pi.displays || []).length > 1 && handler.version_cmp(pi.version, "1.2.4") >= 0;
}

// The local monitors, left to right (then top to bottom), in screen pixels -- the
// units view.move() takes. Never empty: if the toolkit will not enumerate, the
// monitor this window is on stands in for all of them.
function localMonitors() {
    var list = [];
    var n = 1;
    try { n = view.screens; } catch (e) { n = 1; }
    if (!n || n < 1) n = 1;
    for (var i = 0; i < n; ++i) {
        try {
            var (x, y, w, h) = view.screenBox(i, #frame, #rectw);
            if (w > 0 && h > 0) list.push({ x: x, y: y, w: w, h: h });
        } catch (e) {}
    }
    if (list.length == 0) {
        var (x, y, w, h) = view.screenBox(#frame, #rectw);
        list.push({ x: x, y: y, w: w, h: h });
    }
    list.sort(function(a, b) { return a.x != b.x ? a.x - b.x : a.y - b.y; });
    if (!monitors_logged) {
        monitors_logged = true;
        var s = "";
        for (var m in list) s += " [" + m.x + "," + m.y + " " + m.w + "x" + m.h + "]";
        stdout.println("local monitors: view.screens=" + n + " ->" + s);
    }
    return list;
}
var monitors_logged = false;

function multiMonitorAvailable() {
    return localMonitors().length > 1;
}

// Which remote displays the multi-display modes show ("all", "span", "windows"), as a
// sorted list of indices. Chosen in the header's display picker and remembered PER PEER,
// so "only my two work screens of the three" sticks for that computer. Only the chosen
// displays are streamed, which also saves the bandwidth and the encoders of the rest.
// Empty / invalid / stale (display unplugged) -> all of them.
const OPTION_DISPLAYS_SHOWN = "nemo-displays-shown";
// Per peer: the display mode last chosen (empty = single), restored when the next
// session to that peer starts (header.tis updatePi).
const OPTION_DISPLAY_MODE = "nemo-display-mode";
function selectedDisplays() {
    var n = (pi.displays || []).length;
    var sel = [];
    var raw = (handler.get_option(OPTION_DISPLAYS_SHOWN) || "").trim();
    if (raw) {
        for (var part in raw.split(",")) {
            var p = part.trim();
            if (!p) continue;
            var i = p.toInteger();
            if (i >= 0 && i < n && sel.indexOf(i) < 0) sel.push(i);
        }
    }
    if (sel.length == 0) for (var i = 0; i < n; ++i) sel.push(i);
    sel.sort(function(a, b) { return a - b; });
    return sel;
}

// Tick / untick one display. The last one cannot be unticked: a selection of nothing
// would leave the window with nothing to show and no obvious way back.
function toggleDisplaySelected(i) {
    var n = (pi.displays || []).length;
    var sel = selectedDisplays();
    var next = [];
    var had = false;
    for (var s in sel) { if (s == i) had = true; else next.push(s); }
    if (!had) next.push(i);
    if (next.length == 0) return;
    next.sort(function(a, b) { return a - b; });
    handler.set_option(OPTION_DISPLAYS_SHOWN, next.length == n ? "" : next.join(","));
    refreshDisplayMode();
}

function selectAllDisplays() {
    handler.set_option(OPTION_DISPLAYS_SHOWN, "");
    refreshDisplayMode();
}

// Re-run the current multi-display mode with the new selection.
function refreshDisplayMode() {
    var m = display_mode;
    if (m != "single") {
        display_mode = "single";      // so closing display windows is not taken as the user's doing
        leaveDisplayMode(m);
        setDisplayMode(m);
    }
    if (header) header.update();
}

// Remote display indices in the same left-to-right order, so "the left remote screen"
// lands on "the left local screen" whatever order the peer numbered them in. Only the
// displays picked in the display picker take part.
function remoteDisplayOrder() {
    var idx = selectedDisplays();
    idx.sort(function(a, b) {
        var da = pi.displays[a], db = pi.displays[b];
        return da.x != db.x ? da.x - db.x : da.y - db.y;
    });
    return idx;
}

// Fit a remote display into a box, keeping its aspect ratio, centred. Returns the
// tile rect (device px, box-relative) and the device-px-per-remote-px factor that
// handleTileMouse needs to map positions back.
function fitInto(d, bx, by, bw, bh) {
    var fit = bw.toFloat() / d.width;           // float: see layoutViewAll
    if (bh.toFloat() / d.height < fit) fit = bh.toFloat() / d.height;
    var w = d.width * fit, h = d.height * fit;
    return { x: bx + (bw - w) / 2, y: by + (bh - h) / 2, w: w, h: h, fit: fit };
}

function placeTile(t, i, r) {
    t.style.set {
        left: (r.x / scaleFactor) + "px",
        top: (r.y / scaleFactor) + "px",
        width: (r.w / scaleFactor) + "px",
        height: (r.h / scaleFactor) + "px",
    };
    var d = pi.displays[i];
    view_all_layout[i] = { x: d.x, y: d.y, fit: r.fit };
}

function headerAutoHide() {
    return view.windowState == View.WINDOW_FULL_SCREEN
        || display_mode == "span" || display_mode == "windows";
}

function setHeaderVisible(v) {
    var h = $(header);
    if (!h) return;
    if (v) h.style.set { display: "block", padding: "0" };
    else h.style.set { display: "none" };
}

function saveWindowPlacement() {
    if (window_restore) return;   // keep the ORIGINAL placement across mode hops
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    window_restore = { rect: [x, y, w, h], state: view.windowState };
}

function restoreWindowPlacement() {
    if (!window_restore) return;
    var r = window_restore;
    window_restore = null;
    if (view.windowState != View.WINDOW_SHOWN) view.windowState = View.WINDOW_SHOWN;
    view.move(r.rect[0], r.rect[1], r.rect[2], r.rect[3]);
    if (r.state == View.WINDOW_MAXIMIZED || r.state == View.WINDOW_FULL_SCREEN)
        view.windowState = r.state;
    setHeaderVisible(true);
}

// Move + resize, then check where the window actually went and put it back if the
// window manager moved it. A combined move+resize to a size larger than one monitor is
// honoured for the size but not always for the position: in the lab (openbox) the
// window grew to both monitors and was then shifted so that it STARTED on the second
// one, which put remote display 1 on the right screen and display 2 off-screen. A plain
// move once the size has landed is honoured, so re-assert it, twice at most.
function placeWindowAt(x, y, w, h) {
    view.move(x, y, w, h);
    var tries = 2;
    function check() {
        var (cx, cy, cw, ch) = view.box(#rectw, #border, #screen);
        if (cx == x && cy == y) return;
        stdout.println("window placed at " + cx + "," + cy + " instead of " + x + "," + y + "; moving it back");
        view.move(x, y, w, h);
        if (--tries > 0) self.timer(400ms, check);
    }
    self.timer(250ms, check);
}

// "span": cover every local monitor with this one window and give each remote display
// the monitor in the same position. With a different number of remote displays than
// monitors, fall back to the proportional layout of "all", across the whole span.
function enterSpan() {
    var mons = localMonitors();
    if (mons.length < 2) return false;
    saveWindowPlacement();
    var x0 = mons[0].x, y0 = mons[0].y, x1 = x0, y1 = y0;
    for (var m in mons) {
        if (m.x < x0) x0 = m.x;
        if (m.y < y0) y0 = m.y;
        if (m.x + m.w > x1) x1 = m.x + m.w;
        if (m.y + m.h > y1) y1 = m.y + m.h;
    }
    span_map = [];
    var order = remoteDisplayOrder();
    if (order.length == mons.length) {
        for (var k = 0; k < order.length; ++k)
            span_map.push({ disp: order[k],
                            mon: { x: mons[k].x - x0, y: mons[k].y - y0, w: mons[k].w, h: mons[k].h } });
    }
    span_first_width = mons[0].w;
    if (view.windowState != View.WINDOW_SHOWN) view.windowState = View.WINDOW_SHOWN;
    setHeaderVisible(false);
    placeWindowAt(x0, y0, x1 - x0, y1 - y0);
    enterViewAll();
    stdout.println("display mode span: " + mons.length + " monitors, window " + x0 + "," + y0 +
                   " " + (x1 - x0) + "x" + (y1 - y0) + (span_map.length ? ", 1:1 mapping" : ", proportional"));
    return true;
}

// "windows": this window shows the leftmost remote display, full screen on the
// leftmost monitor; every other remote display gets a window from remote.rs on the
// next monitor. More remote displays than monitors: the extras share the last one.
function enterDisplayWindows() {
    var mons = localMonitors();
    if (mons.length < 2) return false;
    var order = remoteDisplayOrder();
    if (order.length < 2) return false;
    saveWindowPlacement();
    var first = order[0];
    pi.current_display = first;
    enterViewAll([first]);
    var m0 = mons[0];
    if (view.windowState != View.WINDOW_SHOWN) view.windowState = View.WINDOW_SHOWN;
    // Onto the first monitor FIRST, full screen only once it is there: full screen
    // fills whichever monitor the window is on.
    placeWindowAt(m0.x, m0.y, m0.w, m0.h);
    self.timer(700ms, function() {
        if (display_mode != "windows") return;
        view.windowState = View.WINDOW_FULL_SCREEN;
        if (is_linux) self.timer(150ms, function() { view.windowState = View.WINDOW_FULL_SCREEN; });
    });
    for (var k = 1; k < order.length; ++k) {
        var i = order[k];
        var d = pi.displays[i];
        var m = mons[k < mons.length ? k : mons.length - 1];
        var title = get_id() + " – " + translate("nemo_display") + " " + (i + 1);
        // Plain concatenation: TIScript does not accept a method call on an array
        // literal ([..].join(...)), and a single parse error disables ALL of remote.tis
        // -- found in the lab as a session that never got past "waiting for screen".
        var rrect = d.x + "," + d.y + "," + d.width + "," + d.height;
        var mrect = m.x + "," + m.y + "," + m.w + "," + m.h;
        var ok = handler.open_display_window(i, rrect, mrect, title);
        stdout.println("display mode windows: display " + (i + 1) + " -> monitor " + m.x + "," + m.y + (ok ? "" : " FAILED"));
    }
    return true;
}

function leaveDisplayMode(mode) {
    if (mode == "windows") handler.close_display_windows();
    if (mode == "all" || mode == "span" || mode == "windows") exitViewAll();
    if (mode == "span" || mode == "windows") {
        span_map = [];
        restoreWindowPlacement();
    }
}

// `persist`: remember the result for this peer. False for the automatic restore at
// session start, so a mode that cannot apply today (span without a second monitor)
// does not overwrite the choice made on the docked machine.
function setDisplayMode(mode, persist = true) {
    if (mode == display_mode) return;
    if (mode != "single" && !viewAllSupported()) return;
    if ((mode == "span" || mode == "windows") && !multiMonitorAvailable()) return;
    var prev = display_mode;
    // Set first: closing display windows calls back into onDisplayWindowClosed, which
    // must see that the user left "windows" on purpose and not treat it as one window
    // being closed by hand.
    display_mode = mode;
    leaveDisplayMode(prev);
    var ok = true;
    if (mode == "all") enterViewAll();
    else if (mode == "span") ok = enterSpan();
    else if (mode == "windows") ok = enterDisplayWindows();
    if (!ok) { display_mode = "single"; restoreWindowPlacement(); }
    if (persist && ok) handler.set_option(OPTION_DISPLAY_MODE, display_mode == "single" ? "" : display_mode);
    if (header) header.update();
}

// A display window was closed. On purpose (we left "windows"), nothing to do. By hand,
// that remote display would otherwise be streamed into nothing -- so the whole session
// returns to a single window showing all displays, which is what the user can still see.
handler.onDisplayWindowClosed = function(disp) {
    if (display_mode != "windows") return;
    stdout.println("display window " + (disp + 1) + " closed by the user");
    self.timer(1ms, function() { setDisplayMode("all"); });
}

// Where each shown display sits in the "all" layout. With every display shown, exactly
// where the remote has them (so a stacked or L-shaped setup looks like itself). With a
// subset, packed left to right in the remote's order: keeping the real positions left the
// unpicked display's slot as an empty hole -- picking 1 and 3 of three put a third of the
// window's width between them.
function shownLayout() {
    var sel = selectedDisplays();
    var rects = {};
    if (sel.length == (pi.displays || []).length) {
        for (var i in sel) {
            var d = pi.displays[i];
            rects[i] = { x: d.x, y: d.y, w: d.width, h: d.height };
        }
        return rects;
    }
    var cur = 0;
    for (var i in remoteDisplayOrder()) {
        var d = pi.displays[i];
        rects[i] = { x: cur, y: 0, w: d.width, h: d.height };
        cur += d.width;
    }
    return rects;
}

function computeDisplaysBBox() {
    var x0 = 9999999, y0 = 9999999, x1 = -9999999, y1 = -9999999;
    var rects = shownLayout();
    for (var k in selectedDisplays()) {
        var r = rects[k];
        if (!r) continue;
        if (r.x < x0) x0 = r.x;
        if (r.y < y0) y0 = r.y;
        if (r.x + r.w > x1) x1 = r.x + r.w;
        if (r.y + r.h > y1) y1 = r.y + r.h;
    }
    return { x0: x0, y0: y0, w: x1 - x0, h: y1 - y0 };
}

function layoutViewAll() {
    if (!view_all_mode || !view_all_wrapper) return;
    var holder = view_all_wrapper.$(div.tiles-holder);
    if (!holder) return;
    var bbox = computeDisplaysBBox();
    if (bbox.w <= 0 || bbox.h <= 0) return;
    var availW = $(body).box(#width, #border);
    var availH = $(body).box(#height, #border);
    var tiles = holder.$$(video.remote-tile);
    if (availW <= 0 || availH <= 0) return;
    // "span" with one remote display per monitor: each tile fills its own monitor.
    if (display_mode == "span" && span_map.length > 0) {
        for (var t in tiles) {
            var i = t.attributes["dispidx"].toInteger();
            var d = pi.displays[i];
            if (!d) continue;
            for (var s in span_map) {
                if (s.disp != i) continue;
                placeTile(t, i, fitInto(d, s.mon.x, s.mon.y, s.mon.w, s.mon.h));
            }
        }
        return;
    }
    // "windows": this window shows exactly one display; give it the whole window.
    if (display_mode == "windows") {
        for (var t in tiles) {
            var i = t.attributes["dispidx"].toInteger();
            var d = pi.displays[i];
            if (d) placeTile(t, i, fitInto(d, 0, 0, availW, availH));
        }
        return;
    }
    // toFloat(): in TIScript int / int is INTEGER division, so 1280 / 2560 was 0 and
    // every tile came out 0x0 -- "view all displays" only ever worked in a window
    // larger than the remote's whole desktop. Found in the lab, two 1280x900 displays.
    var fit = availW.toFloat() / bbox.w;
    var fit_y = availH.toFloat() / bbox.h;
    if (fit_y < fit) fit = fit_y;
    var totalW = bbox.w * fit;
    var totalH = bbox.h * fit;
    var offX = (availW - totalW) / 2;
    var offY = (availH - totalH) / 2;
    var rects = shownLayout();
    for (var t in tiles) {
        var i = t.attributes["dispidx"].toInteger();
        var d = pi.displays[i];
        var r = rects[i];
        if (!d || !r) continue;
        var left = (offX + (r.x - bbox.x0) * fit) / scaleFactor;
        var top = (offY + (r.y - bbox.y0) * fit) / scaleFactor;
        var w = (d.width * fit) / scaleFactor;
        var h = (d.height * fit) / scaleFactor;
        t.style.set {
            left: left + "px",
            top: top + "px",
            width: w + "px",
            height: h + "px",
        };
        view_all_layout[i] = { x: d.x, y: d.y, fit: fit };
    }
}

function handleTileMouse(evt, dispIndex) {
    if (is_file_transfer || is_port_forward) return false;
    var L = view_all_layout[dispIndex];
    var mask = 0;
    var wheel_dx = 0;
    var wheel_dy = 0;
    switch (evt.type) {
      case Event.MOUSE_DOWN: mask = 1; break;
      case Event.MOUSE_UP: mask = 2; break;
      case Event.MOUSE_MOVE: mask = 0; break;
      case Event.MOUSE_DCLICK: mask = 1; break;
      case Event.MOUSE_WHEEL:
        mask = 3;
        // TIScript needs a braced block for a `var (...)` destructuring inside a
        // case (a bare case label can't take the declaration) — mirror the existing
        // wheel handler below.
        {
            var (rdx, rdy) = evt.wheelDeltas;
            wheel_dx = rdx > 0 ? 1 : (rdx < 0 ? -1 : 0);
            wheel_dy = rdy > 0 ? 1 : (rdy < 0 ? -1 : 0);
            if (Math.abs(rdx) > Math.abs(rdy)) wheel_dy = 0; else wheel_dx = 0;
        }
        if (wheel_dx == 0 && wheel_dy == 0) return keyboard_enabled;
        break;
      case Event.MOUSE_ENTER:
        entered = true;
        handler.enter(handler.get_keyboard_mode());
        holdKeyboardGrab();
        return keyboard_enabled;
      case Event.MOUSE_LEAVE:
        entered = false;
        handler.leave(handler.get_keyboard_mode());
        return keyboard_enabled;
      default:
        return false;
    }
    // The header is hidden while full screen, spanning or one-window-per-display; the
    // main surface reveals it when the pointer rests on the top edge (handler.onMouse),
    // but tiles sit on top of that surface and swallow the pointer -- without this the
    // toolbar, and with it the way back out of these modes, was unreachable.
    if (mask == 0 && headerAutoHide()) revealHeaderAt(evt.yView);
    if (mask == 0 && entered) holdKeyboardGrab();
    if (!keyboard_enabled) return false;
    var rx = 0;
    var ry = 0;
    if (mask == 0 && L) {
        rx = (L.x + evt.x / L.fit).toInteger();
        ry = (L.y + evt.y / L.fit).toInteger();
    }
    handler.send_mouse((evt.buttons << 3) | mask,
        mask == 3 ? wheel_dx : rx,
        mask == 3 ? wheel_dy : ry,
        evt.altKey, evt.ctrlKey, evt.shiftKey, evt.commandKey);
    return true;
}

function attachTileMouse(tile, dispIndex) {
    tile.onMouse = function(evt) {
        return handleTileMouse(evt, dispIndex);
    };
}

// `shown` = the displays to tile in THIS window (default: the picked ones). The peer is
// asked for every PICKED display: in "windows" mode the rest are drawn by the other
// windows, which bind into the same per-display frame routing.
function enterViewAll(shown = null) {
    if (view_all_mode) return;
    if (!viewAllSupported()) return;
    view_all_wrapper = $(#video-all-wrapper);
    if (!view_all_wrapper) return;
    view_all_mode = true;
    view_all_layout = {};
    var picked = selectedDisplays();
    if (!shown) shown = picked;
    var vnodes = [];
    for (var i = 0; i < pi.displays.length; ++i) {
        if (shown.indexOf(i) < 0) continue;
        vnodes.push(<video class="remote-tile" dispidx={i.toString()} />);
    }
    view_all_wrapper.content(<div class="tiles-holder">{vnodes}</div>);
    view_all_wrapper.style.set { display: "block" };
    // The top edge is not always a tile: three remote screens across two monitors are
    // letterboxed, so the top rows are background. The tiles reveal the header on their
    // own (handleTileMouse); this covers the background, or span / window-per-display
    // would leave no way back to the toolbar (found on Windows, 3 screens on 2 monitors).
    view_all_wrapper.onMouse = function(evt) {
        if (evt.type == Event.MOUSE_MOVE && headerAutoHide()) revealHeaderAt(evt.yView);
        return false;
    };
    var tiles = view_all_wrapper.$$(video.remote-tile);
    for (var t in tiles) {
        attachTileMouse(t, t.attributes["dispidx"].toInteger());
    }
    layoutViewAll();
    // Ask the peer (and Rust routing) to stream the picked displays at once.
    handler.set_view_all(picked.join(","));
}

function exitViewAll() {
    if (!view_all_mode) return;
    view_all_mode = false;
    handler.set_view_all("");
    if (view_all_wrapper) {
        // Hide first, then drop the tile elements (unbinds their video surfaces).
        view_all_wrapper.style.set { display: "none" };
        view_all_wrapper.content("");
    }
    view_all_layout = {};
    // Restore single-display capture for the current display.
    handler.switch_display(pi.current_display);
}

function toggleViewAll() {
    setDisplayMode(display_mode == "all" ? "single" : "all");
}

// The keyboard grab follows enter/leave. With ONE window that is all it needs. With a
// display window per monitor, moving from one window of this session to the other can
// deliver the old window's "leave" AFTER the new window's "enter"; the grab sees the
// enter as "already the owner, nothing to do" and then the late leave releases it --
// mouse still works, every keystroke goes nowhere (found in the lab). So re-assert the
// enter shortly after entering, and every 250 ms while the pointer moves: whichever
// window actually holds the pointer wins, whatever order the events came in.
var grab_refresh_pending = false;
function holdKeyboardGrab() {
    if (grab_refresh_pending) return;
    grab_refresh_pending = true;
    self.timer(250ms, function() {
        grab_refresh_pending = false;
        if (entered) handler.enter(handler.get_keyboard_mode());
    });
}

var reveal_pending = false;
// Show the header while the pointer rests on the window's top edge, hide it once the
// pointer moves away -- the same gesture full screen has always used.
function revealHeaderAt(y) {
    var h = $(header);
    if (!h) return;
    // A few pixels, not exactly the top row: outside full screen the window has a 1px
    // border, so the topmost row the tiles ever see is y=1..3 (lab, spanning window).
    if (y <= 4) {
        if (reveal_pending || h.style#display == "block") return;
        reveal_pending = true;
        self.timer(300ms, function() {
            if (!reveal_pending) return;
            reveal_pending = false;
            if (headerAutoHide()) {
                h.style.set { display: "block", padding: (2 * workarea_offset) + "px 0 0 0" };
                updateWindowToolbarPosition();
            }
        });
    } else {
        reveal_pending = false;
        if (y > 40 && h.style#display != "none") h.style.set { display: "none" };
    }
}

// https://sciter.com/event-handling/
// https://sciter.com/docs/content/sciter/Event.htm

var entered = false;
if (!is_file_transfer && !is_port_forward) {
    self.onKey = function(evt) {
        if (!entered) return false;
        // so that arrow key not move scrollbar
        return true; 
    }
}

var wait_window_toolbar = false;
var last_mouse_mask;
var is_left_down = false;
var acc_wheel_delta_x = 0;
var acc_wheel_delta_y = 0;
var last_wheel_time = 0;
var inertia_velocity_x = 0;
var inertia_velocity_y = 0;
var acc_wheel_delta_x0 = 0;
var acc_wheel_delta_y0 = 0;
var total_wheel_time = 0;
var wheeling = false;
var dragging = false;
var is_mouse_event_triggered = false;

// https://stackoverflow.com/questions/5833399/calculating-scroll-inertia-momentum
function resetWheel() {
    acc_wheel_delta_x = 0;
    acc_wheel_delta_y = 0;
    last_wheel_time = 0;
    inertia_velocity_x = 0;
    inertia_velocity_y = 0;
    acc_wheel_delta_x0 = 0;
    acc_wheel_delta_y0 = 0;
    total_wheel_time = 0;
    wheeling = false;
}

var INERTIA_ACCELERATION = 30;
var WHEEL_ACCEL_VELOCITY_THRESHOLD = 5000;
var WHEEL_ACCEL_DT_FAST = 0.04;
var WHEEL_ACCEL_DT_MEDIUM = 0.08;
var WHEEL_ACCEL_VALUE_FAST = 3;
var WHEEL_ACCEL_VALUE_MEDIUM = 2;
// Wheel burst acceleration (empirical tuning).
// Applies only on fast, non-smooth wheel bursts to keep single-step scroll unchanged.
// Sciter uses seconds for dt, so velocity is in delta/sec.

// not good, precision not enough to simulate acceleration effect,
// seems have to use pixel based rather line based delta
function accWheel(v, is_x) {
    if (wheeling) return;
    var abs_v = Math.abs(v);
    var max_t = abs_v / INERTIA_ACCELERATION;
    for (var t = 0.1; t < max_t; t += 0.1) {
        var d = Math.round((abs_v - t * INERTIA_ACCELERATION / 2) * t).toInteger();
        if (d >= 1) {
            abs_v -= t * INERTIA_ACCELERATION;
            if (v < 0) {
                d = -d;
                v = -abs_v;
            } else {
                v = abs_v;
            }
            handler.send_mouse(3, is_x ? d : 0, !is_x ? d : 0, false, false, false, false);
            accWheel(v, is_x);
            break;
        }
    }
}

function handler.onMouse(evt)
{
    is_mouse_event_triggered = true;
    if (is_file_transfer || is_port_forward) return false;
    if (view.windowState == View.WINDOW_FULL_SCREEN && !dragging) {
        var dy = evt.y - scroll_body.scroll(#top);
        if (dy <= 1) {
            if (!wait_window_toolbar) {
                wait_window_toolbar = true;
                self.timer(300ms, function() {
                    if (!wait_window_toolbar) return;
                    var extra = 0;
                    // workaround for stupid Sciter, without this, click
                    // event not triggered on top part of buttons on toolbar
                    if (is_osx) extra = 10; 
                    if (view.windowState == View.WINDOW_FULL_SCREEN) {
                        $(header).style.set {
                          display: "block",
                          padding: (2 * workarea_offset + extra) + "px 0 0 0",
                        };
                    }
                    wait_window_toolbar = false;
                });
            }
        } else {
            wait_window_toolbar = false;
            var h = $(header).style;
            if (dy > 20 && h#display != "none") {
              h.set {
                  display: "none",
              };
            }
        } 
    }
    if (!got_mouse_control) {
        if (Math.abs(evt.x - cur_local_x) > 12 || Math.abs(evt.y - cur_local_y) > 12) {
            got_mouse_control = true;
        } else {
            return;
        }
    }
    var mask = 0;
    var wheel_delta_x;
    var wheel_delta_y;
    switch(evt.type) {
      case Event.MOUSE_DOWN:
        mask = 1;
        dragging = true;
        break; 
      case Event.MOUSE_UP:
        mask = 2;
        dragging = false;
        break;
      case Event.MOUSE_MOVE:
        if (display_cursor_embedded) {
            break;
        }
        if (cursor_img.style#display != "none" && keyboard_enabled) {
            cursor_img.style#display = "none";
        }
        if (!keyboard_enabled && !useSystemCursor) {
            updateCursor(true);
        }
        if (keyboard_enabled && useSystemCursor) {
            updateCursor();
        }
        break;
      case Event.MOUSE_WHEEL:
        // mouseWheelDistance = 8 * [currentUserDefs floatForKey:@"com.apple.scrollwheel.scaling"];
        mask = 3; 
        {
            var now = getTime();
            var dt = last_wheel_time > 0 ? (now - last_wheel_time) / 1000 : 0;
            var (raw_dx, raw_dy) = evt.wheelDeltas;
            var dx = 0;
            var dy = 0;
            var abs_dx = Math.abs(raw_dx);
            var abs_dy = Math.abs(raw_dy);
            var dominant = abs_dx > abs_dy ? abs_dx : abs_dy;
            var is_smooth = dominant < 1;
            var accel = 1;
            if (!is_smooth && dt > 0 && (is_win || is_linux) && get_peer_platform() == "Mac OS") {
                var velocity = dominant / dt;
                if (velocity >= WHEEL_ACCEL_VELOCITY_THRESHOLD) {
                    if (dt < WHEEL_ACCEL_DT_FAST) accel = WHEEL_ACCEL_VALUE_FAST;
                    else if (dt < WHEEL_ACCEL_DT_MEDIUM) accel = WHEEL_ACCEL_VALUE_MEDIUM;
                }
            }
            if (raw_dx > 0) dx = accel;
            else if (raw_dx < 0) dx = -accel;
            if (raw_dy > 0) dy = accel;
            else if (raw_dy < 0) dy = -accel;
            if (abs_dx > abs_dy) {
                dy = 0;
            } else {
                dx = 0;
            }
            acc_wheel_delta_x += dx;
            acc_wheel_delta_y += dy;
            wheel_delta_x = acc_wheel_delta_x.toInteger();
            wheel_delta_y = acc_wheel_delta_y.toInteger();
            acc_wheel_delta_x -= wheel_delta_x;
            acc_wheel_delta_y -= wheel_delta_y;
            if (dt > 0) {
                var vx = dx / dt;
                var vy = dy / dt;
                if (vx != 0 || vy != 0) {
                    inertia_velocity_x = vx;
                    inertia_velocity_y = vy;
                }
            }
            acc_wheel_delta_x0 += dx;
            acc_wheel_delta_y0 += dy;
            total_wheel_time += dt;
            if (dx == 0 && dy == 0) {
                wheeling = false;
                if (dt < 0.1 && total_wheel_time > 0) {
                    var v2 = (acc_wheel_delta_y0 / total_wheel_time) * inertia_velocity_y;
                    if (v2 > 0) {
                        v2 = Math.sqrt(v2);
                        inertia_velocity_y = inertia_velocity_y < 0 ? -v2  : v2;
                        accWheel(inertia_velocity_y, false);
                    }
                    v2 = (acc_wheel_delta_x0 / total_wheel_time) * inertia_velocity_x;
                    if (v2 > 0) {
                        v2 = Math.sqrt(v2);
                        inertia_velocity_x = inertia_velocity_x < 0 ? -v2  : v2;
                        accWheel(inertia_velocity_x, true);
                    }
                }
                resetWheel();
            } else {
                wheeling = true;
            }
            last_wheel_time = now;
            if (wheel_delta_x == 0 && wheel_delta_y == 0) return keyboard_enabled;
        }
        break;
      case Event.MOUSE_DCLICK: // seq: down, up, dclick, up
        mask = 1;
        break;
      case Event.MOUSE_ENTER:
        entered = true;
        stdout.println("enter");
        handler.enter(handler.get_keyboard_mode());
        last_wheel_time = 0;
        return keyboard_enabled;
      case Event.MOUSE_LEAVE:
        entered = false;
        stdout.println("leave");
        handler.leave(handler.get_keyboard_mode());
        last_wheel_time = 0;
        if (is_left_down && get_peer_platform() == "Android") {
            is_left_down = false;
            handler.send_mouse((1 << 3) | 2, 0, 0, evt.altKey,
                evt.ctrlKey, evt.shiftKey, evt.commandKey);
        }
        return keyboard_enabled;
      default:
        return false;
    }
    var x = evt.x;
    var y = evt.y;
    if (mask != 0) {
        // to gain control of the mouse, user must move mouse
        if (cur_x != x || cur_y != y) {
            return keyboard_enabled;
        }
    } else {
        cur_local_x = cur_x = x;
        cur_local_y = cur_y = y;
    }
    if (mask != 3) {
        resetWheel();
    }
    if (!keyboard_enabled) return false;
    x = (x / cursor_scale).toInteger();
    y = (y / cursor_scale).toInteger();
    // insert down between two up, osx has this behavior for triple click
    if (last_mouse_mask == 2 && mask == 2) {
        handler.send_mouse((evt.buttons << 3) | 1, 0, 0, evt.altKey,
                evt.ctrlKey, evt.shiftKey, evt.commandKey);
    }
    last_mouse_mask = mask;
    if (evt.buttons == 1) {
        if (mask == 1) {
            is_left_down = true;
        } else if (mask == 2) {
            is_left_down = false;
        }
    }
    // to-do: altKey, ctrlKey etc
    handler.send_mouse((evt.buttons << 3) | mask,
                mask == 3 ? wheel_delta_x : (mask == 0 ? x + display_origin_x : 0),
                mask == 3 ? wheel_delta_y : (mask == 0 ? y + display_origin_y : 0),
                evt.altKey,
                evt.ctrlKey, evt.shiftKey, evt.commandKey);
    return true;
};

var cur_id = -1;
var cur_hotx = 0;
var cur_hoty = 0;
var cur_img = null;
var cur_x = 0;
var cur_y = 0;
var cur_local_x = 0;
var cur_local_y = 0;
var cursors = {};
var image_binded;

function scaleCursorImage(img) {
    var factor = cursor_scale;
    if (cursor_img.style#display != 'none') {
        factor /= scaleFactor;
    }
    var w = (img.width * factor).toInteger();
    var h = (img.height * factor).toInteger();
    cursor_img.style.set {
        width: w + "px",
        height: h + "px",
    };
    self.bindImage("in-memory:cursor", img);
    if (factor == 1) return img;
    function paint(gfx) {
        gfx.drawImage(img, 0, 0, w, h);
    }
    return new Image(w, h, paint);
}

var useSystemCursor = true;
function updateCursor(system=false) {
    stdout.println("Update cursor, system: " + system);
    useSystemCursor = system;
    if (system) {
        handler.style#cursor = undefined;
    } else if (cur_img) {
        handler.style.cursor(cur_img, (cur_hotx * cursor_scale).toInteger(), (cur_hoty * cursor_scale).toInteger());
    }
}

function refreshCursor() {
    if (display_cursor_embedded) {
        cursor_img.style#display = "none";
        return;
    }
    if (cur_id != -1) {
        handler.setCursorId(cur_id);
    }
}

handler.setCursorData = function(id, hotx, hoty, width, height, colors) {
    cur_hotx = hotx;
    cur_hoty = hoty;
    var img = Image.fromBytes(colors);
    if (img) {
        image_binded = true;
        cursors[id] = [img, hotx, hoty, width, height];
        cur_id = id;
        img = scaleCursorImage(img);
        if (!first_mouse_event_triggered || cursor_img.style#display == 'none') {
            self.timer(1ms, updateCursor);
        }
        cur_img = img;
    }
}

handler.setCursorId = function(id) {
    var img = cursors[id];
    if (img) {
        cur_id = id;
        image_binded = true;
        cur_hotx = img[1];
        cur_hoty = img[2];
        img = scaleCursorImage(img[0]);
        if (!first_mouse_event_triggered || cursor_img.style#display == 'none') {
            self.timer(1ms, updateCursor);
        }
        cur_img = img;
    }
}

var got_mouse_control = true;
handler.setCursorPosition = function(x, y) {
    if (!image_binded) return;
    got_mouse_control = false;
    cur_x = x - display_origin_x;
    cur_y = y - display_origin_y;
    var x = cur_x - cur_hotx;
    var y = cur_y - cur_hoty;
    x *= cursor_scale / scaleFactor;
    y *= cursor_scale / scaleFactor;
    cursor_img.style.set {
        left: x + "px",
        top: y + "px",
    };
    if (cursor_img.style#display == 'none') {
        cursor_img.style#display = "block";
        refreshCursor();
    }
}

function self.ready() {
    var w = scaleIt(960);
    var h = scaleIt(640);
    if (is_file_transfer || is_port_forward) {
        var r = handler.get_size();
        if (isReasonableSize(r) && r[2] > 0) {
            view.move(r[0], r[1], r[2], r[3]);
        } else {
            centerize(w, h);
        }
    } else {
        centerize(w, h);
    }
    if (!is_port_forward) connecting();
    if (is_file_transfer) initializeFileTransfer();
    if (is_port_forward) initializePortForward();
}

var workarea_offset = 0;
var size_adapted;
handler.adaptSize = function() {
    if (size_adapted) return;
    size_adapted = true;
    var (sx, sy, sw, sh) = view.screenBox(#workarea, #rectw);
    var (fx, fy, fw, fh) = view.screenBox(#frame, #rectw);
    if (is_osx) workarea_offset = sy;
    var r = handler.get_size();
    if (isReasonableSize(r) && r[2] > 0) {
        if (r[2] >= fw && r[3] >= fh && !is_linux) {
            view.windowState = View.WINDOW_FULL_SCREEN;
            stdout.println("Initialize to full screen");
        } else if (r[2] >= sw && r[3] >= sh) {
            view.windowState = View.WINDOW_MAXIMIZED;
            stdout.println("Initialize to full screen");
        } else {
            view.move(r[0], r[1], r[2], r[3]);
        }
    } else {
        var w = handler.box(#width, #border)
        var h = handler.box(#height, #border)
        if (w >= sw || h >= sh) {
            view.windowState = View.WINDOW_MAXIMIZED;
            return;
        }
        // extra for border
        var extra = 2;
        centerize(w + extra, handler.box(#height, #border) + h + extra);
    }
}

function self.closing() {
    var (x, y, w, h) = view.box(#rectw, #border, #screen);
    if (is_file_transfer) save_file_transfer_close_state();
    if (is_file_transfer || is_port_forward || size_adapted) handler.save_size(x, y, w, h);
    if (recording) handler.record_screen(false, 0, display_width, display_height);
}

var qualityMonitor;
var qualityMonitorData = [];

class QualityMonitor: Reactor.Component
{
    function this() {
        qualityMonitor = this;
        if (handler.get_toggle_option("show-quality-monitor")) {
            $(#quality-monitor).style.set{ display: "block" };
        }
    }

    function render() {
        return <div >
            <div>
                Speed: {qualityMonitorData[0]}
            </div>
            <div>
                FPS: {qualityMonitorData[1]}
            </div>
            <div>
                Delay: {qualityMonitorData[2]} ms
            </div>
            <div>
                Target Bitrate: {qualityMonitorData[3]}kb
            </div>
            <div>
                Codec: {qualityMonitorData[4]}
            </div>
            <div>
                Chroma: {qualityMonitorData[5]}
            </div>
        </div>;
    }
}

$(#quality-monitor).content(<QualityMonitor />);
handler.updateQualityStatus = function(speed, fps, delay, bitrate, codec_format, chroma) {
    if (speed !== null) qualityMonitorData[0] = speed;
    if (fps !== null) qualityMonitorData[1] = fps;
    if (delay !== null) qualityMonitorData[2] = qualityMonitorData[1] === 0 ? 0 : delay;
    if (bitrate !== null) qualityMonitorData[3] = bitrate;
    if (codec_format !== null) qualityMonitorData[4] = codec_format;
    if (chroma !== null) qualityMonitorData[5] = chroma;
    qualityMonitor.update();
}

handler.setPermission = function(name, enabled) {
    self.timer(60ms, function() {
    if (name == "keyboard") keyboard_enabled = enabled;
    if (name == "audio") audio_enabled = enabled;
    if (name == "file") file_enabled = enabled;
    if (name == "clipboard") clipboard_enabled = enabled;
    if (name == "restart") restart_enabled = enabled;
    if (name == "recording") recording_enabled = enabled;
    if (name == "privacy_mode") privacy_mode_enabled = enabled;
    input_blocked = false;
    header.update();
    });
}

handler.closeSuccess = function() {
    // handler.msgbox("success", "Successful", "Ready to go.");
    handler.msgbox("", "", "");
}
